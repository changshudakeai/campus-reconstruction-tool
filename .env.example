# Optional. Enables live Gaode Web Service POI search.
VITE_GAODE_WEB_SERVICE_KEY=

# Use js_api with a Web JS API key and its Security JS Code.
# Omit VITE_GAODE_PROVIDER to use the REST Web Service provider instead.
VITE_GAODE_PROVIDER=
VITE_GAODE_SECURITY_JS_CODE=

# Optional. Override when using a local/proxied Gaode-compatible API service.
VITE_GAODE_POI_ENDPOINT=https://restapi.amap.com/v3/place/text
VITE_GAODE_REGEOCODE_ENDPOINT=https://restapi.amap.com/v3/geocode/regeo

# Optional. Defaults to the bundled public/campus-building-annotations folder.
# Can later point at a raw GitHub/CDN folder containing the same index schema.
VITE_CAMPUS_ANNOTATION_BASE_URL=/campus-building-annotations

# `npm run desktop:dev` configures these automatically for the Tauri backend.
# When starting the pieces manually, set them in the Tauri process environment:
# OVERTURE_BUILDING_ENDPOINT=http://127.0.0.1:8765/overture/buildings
# OVERTURE_RELEASE_ID=latest

# Explicit offline/debug opt-in. Fixtures are never the default product path.
VITE_BUILDING_GEOMETRY_OFFLINE_FIXTURE=false

# Optional release request shown in frontend provenance. The backend remains the
# authority and may apply OVERTURE_RELEASE_ID instead.
VITE_OVERTURE_RELEASE_ID=

# Production Foundation acquisition uses only the authenticated controlled /v1 service.
CAMPUS_ACQUISITION_SERVICE_URL=https://acquisition.example.invalid

# Development/test only. Exercises the same typed client with canonical fixtures.
CAMPUS_V11_ACQUISITION_FIXTURE=0

# Optional. HTTP endpoint implementing the Visual Feature Provider v1 JSON contract.
VITE_VISUAL_FEATURE_ENDPOINT=

# Development-only rollback after a live candidate has been explicitly selected.
# Never changes candidate acquisition and never enables fixture fallback.
VITE_USE_LEGACY_DETAILED_GENERATOR=false
