{
    "name": "campus-reconstruction-tool",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm run native:run",
        "build": "npm run native:build",
        "preview": "npm run native:run",
        "web:dev": "vite --host 127.0.0.1 --port 1420",
        "web:build": "tsc && vite build",
        "web:preview": "vite preview --host 127.0.0.1",
        "legacy:tauri": "tauri",
        "overture:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-overture-service.ps1",
        "overture:serve": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-overture-service.ps1",
        "desktop:dev": "npm run native:run",
        "clean:rust": "cargo +stable clean --manifest-path native/Cargo.toml",
        "native:check": "cargo +stable check --manifest-path native/Cargo.toml --workspace",
        "native:test": "cargo +stable test --manifest-path native/Cargo.toml --workspace && cargo +stable test --manifest-path src-tauri/crates/arnis-core/Cargo.toml",
        "native:run": "cargo +stable run --manifest-path native/Cargo.toml -p campus-native",
        "native:build": "cargo +stable build --manifest-path native/Cargo.toml --workspace --release",
        "bundle:v1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native-installer.ps1",
        "size:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/report-release-size.ps1",
        "test:offline-contracts": "node scripts/run-offline-smokes.mjs",
        "test:smoke": "node scripts/smoke-app-shell.mjs",
        "test:adapter": "node scripts/smoke-minimal-arnis-adapter.mjs",
        "test:query": "node scripts/smoke-online-map-query.mjs",
        "test:campus-workflow": "node scripts/smoke-campus-workflow.mjs",
        "test:campus-naming": "node scripts/smoke-campus-naming-classification.mjs",
        "test:tauri-runtime": "node scripts/smoke-tauri-runtime-guard.mjs",
        "test:review": "node scripts/smoke-candidate-review.mjs",
        "test:schematic": "node scripts/smoke-schematic-generation.mjs",
        "test:previewer": "node scripts/smoke-schematic-previewer.mjs",
        "test:i18n": "node scripts/smoke-i18n.mjs",
        "test:live-map": "node scripts/smoke-live-map-providers.mjs",
        "test:building-location-anchor": "node scripts/smoke-building-location-anchor.mjs",
        "test:foundation-export": "node scripts/smoke-foundation-schematic-export.mjs",
        "test:geometry-editing": "node scripts/smoke-geometry-editing.mjs",
        "test:foundation-style": "node scripts/smoke-foundation-style-controls.mjs",
        "test:provider-debug": "node scripts/smoke-provider-debug-cache.mjs",
        "test:foundation-preview": "node scripts/smoke-foundation-export-preview.mjs",
        "test:foundation-manifest": "node scripts/smoke-foundation-manifest-export.mjs",
        "test:manifest-contract": "node scripts/smoke-foundation-manifest-contract.mjs",
        "test:representative-building": "node scripts/smoke-representative-building-selection.mjs",
        "test:detailed-slot": "node scripts/smoke-detailed-mode-slot-selection.mjs",
        "test:building-geometry-handoff": "node scripts/smoke-building-geometry-slot-handoff.mjs",
        "test:building-geometry-summary": "node scripts/smoke-building-geometry-summary.mjs",
        "test:overture-building": "node scripts/smoke-overture-building-provider.mjs",
        "test:live-overture": "node scripts/smoke-live-overture.mjs",
        "test:overpass-building": "node scripts/smoke-overpass-building-fallback.mjs",
        "test:building-identity": "node scripts/smoke-building-identity.mjs",
        "test:evidence-derivation": "node scripts/smoke-evidence-derivation.mjs",
        "test:high-fidelity-generator": "node scripts/smoke-high-fidelity-generator.mjs",
        "test:live-overpass-building": "node scripts/smoke-live-overpass-building.mjs",
        "test:manual-building-correction": "node scripts/smoke-manual-building-geometry-correction.mjs",
        "test:detailed-schematic-handoff": "node scripts/smoke-detailed-schematic-model-handoff.mjs",
        "test:three-preview-rendering": "node scripts/smoke-three-preview-rendering.mjs",
        "test:block-inspection": "node scripts/smoke-block-inspection-details.mjs",
        "test:batch-replacement": "node scripts/smoke-batch-block-replacement.mjs",
        "test:replacement-preview": "node scripts/smoke-replacement-preview-update.mjs",
        "test:detailed-export": "node scripts/smoke-detailed-schematic-export.mjs",
        "test:export-provenance": "node scripts/smoke-export-provenance.mjs",
        "test:vertical-slice": "node scripts/smoke-first-vertical-slice-completion.mjs",
        "test:visual-checkpoints": "node scripts/smoke-visual-checkpoints.mjs",
        "test:arnis-rust-core": "node scripts/smoke-arnis-rust-core-adapter.mjs",
        "test": "npm run native:test",
        "test:workflow-revision": "node scripts/smoke-workflow-revision.mjs",
        "test:campus-foundation-review": "node scripts/smoke-campus-foundation-review.mjs",
        "test:gaode-map-disposal": "node scripts/smoke-gaode-map-disposal.mjs",
        "test:campus-evolution": "node scripts/smoke-campus-evolution.mjs",
        "test:project-store": "node scripts/smoke-campus-project-store.mjs",
        "test:candidate-confidence": "node scripts/smoke-candidate-confidence.mjs",
        "test:axiom-acceptance": "node scripts/smoke-axiom-acceptance.mjs",
        "test:external-model-review": "node scripts/smoke-external-model-review.mjs",
        "test:external-model-discovery": "node scripts/smoke-external-model-discovery.mjs",
        "test:source-conflict-review": "node scripts/smoke-source-conflict-review.mjs",
        "test:semantic-feature-preservation": "node scripts/smoke-semantic-feature-preservation.mjs",
        "test:visual-recovery": "node scripts/smoke-visual-feature-recovery.mjs"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.0.0",
        "@tauri-apps/plugin-dialog": "^2.7.1",
        "lucide-react": "^0.468.0",
        "polygon-clipping": "^0.15.7",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "three": "^0.170.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.0.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/three": "^0.170.0",
        "@vitejs/plugin-react": "^4.3.3",
        "typescript": "^5.6.3",
        "vite": "^5.4.11"
    }
