{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mcrebuild.invalid/v1/acquisition.schema.json",
  "title": "Controlled Foundation Acquisition Contract v1",
  "oneOf": [
    {"$ref": "#/$defs/capabilities"},
    {"$ref": "#/$defs/boundaryRequest"},
    {"$ref": "#/$defs/acquisitionRequest"},
    {"$ref": "#/$defs/coarseRasterRequest"},
    {"$ref": "#/$defs/jobStatus"},
    {"$ref": "#/$defs/resultManifest"},
    {"$ref": "#/$defs/boundaryDiscoverySnapshot"},
    {"$ref": "#/$defs/acquisitionFixture"},
    {"$ref": "#/$defs/coarseRasterFixture"},
    {"$ref": "#/$defs/failure"}
  ],
  "$defs": {
    "contractVersion": {"type": "string", "const": "1.0.0"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "category": {"enum": ["building", "circulation", "water", "vegetation", "sports"]},
    "outcomeStatus": {"enum": ["complete", "complete-empty", "partial", "failed", "cancelled"]},
    "coarseRasterAlgorithmProfile": {
      "type": "object",
      "required": ["algorithmVersion", "vectorizationVersion", "thresholds", "minimumComponentPixels", "simplificationToleranceMetres"],
      "properties": {
        "algorithmVersion": {"type": "string", "minLength": 1},
        "vectorizationVersion": {"type": "string", "minLength": 1},
        "thresholds": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
        "minimumComponentPixels": {"type": "integer", "minimum": 1},
        "simplificationToleranceMetres": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "datasetBundle": {
      "type": "object",
      "required": ["id", "osm_snapshot", "overture_release", "output_schema", "classification_rules", "assembly_rules", "conflation_rules", "derivation_rules", "coarse_raster_profiles"],
      "properties": {
        "id": {"type": "string"},
        "osm_snapshot": {"type": "string"},
        "overture_release": {"type": "string"},
        "output_schema": {"type": "string"},
        "classification_rules": {"type": "string"},
        "assembly_rules": {"type": "string"},
        "conflation_rules": {"type": "string"},
        "derivation_rules": {"type": "string"},
        "coarse_raster_profiles": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/coarseRasterAlgorithmProfile"}}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["contract_versions", "supported_bundles", "limits", "retention_days"],
      "properties": {
        "contract_versions": {"type": "array", "contains": {"$ref": "#/$defs/contractVersion"}},
        "supported_bundles": {"type": "array", "items": {"$ref": "#/$defs/datasetBundle"}},
        "refresh_bundle_precedence": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "limits": {
          "type": "object",
          "required": ["area_square_metres", "boundary_vertices", "tiles", "observations", "result_bytes", "concurrent_jobs"],
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "retention_days": {"type": "integer", "minimum": 30},
        "quota_remaining": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "requestIdentity": {
      "type": "object",
      "required": ["idempotency_key", "content_sha256"],
      "properties": {"idempotency_key": {"type": "string"}, "content_sha256": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": false
    },
    "boundaryRequest": {
      "type": "object",
      "required": ["contract_version", "request_identity", "bundle_id", "campus_target"],
      "properties": {
        "contract_version": {"$ref": "#/$defs/contractVersion"},
        "request_identity": {"$ref": "#/$defs/requestIdentity"},
        "bundle_id": {"type": "string"},
        "campus_target": {
          "type": "object",
          "required": ["name", "aliases", "anchor_wgs84", "search_radius_m"],
          "properties": {
            "name": {"type": "string"},
            "aliases": {"type": "array", "items": {"type": "string"}},
            "anchor_wgs84": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false},
            "search_radius_m": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "acquisitionRequest": {
      "type": "object",
      "required": ["contract_version", "request_identity", "bundle_id", "boundary_revision", "boundary_wgs84", "categories"],
      "properties": {
        "contract_version": {"$ref": "#/$defs/contractVersion"},
        "request_identity": {"$ref": "#/$defs/requestIdentity"},
        "bundle_id": {"type": "string"},
        "boundary_revision": {"type": "string"},
        "boundary_wgs84": {"$ref": "#/$defs/geometry"},
        "categories": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/category"}}
      },
      "additionalProperties": false
    },
    "coarseRasterRequest": {
      "type": "object",
      "required": ["contract_version", "request_identity", "bundle_id", "boundary_revision", "category", "linked_gap_id", "gap_tile_id", "gap_geometry", "algorithm_version"],
      "properties": {
        "contract_version": {"$ref": "#/$defs/contractVersion"},
        "request_identity": {"$ref": "#/$defs/requestIdentity"},
        "bundle_id": {"type": "string"},
        "boundary_revision": {"type": "string"},
        "category": {"enum": ["water", "vegetation"]},
        "linked_gap_id": {"type": "string"},
        "gap_tile_id": {"type": "string"},
        "gap_geometry": {"$ref": "#/$defs/geometry"},
        "algorithm_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "retryRequest": {
      "type": "object",
      "required": ["scopes"],
      "properties": {"scopes": {"type": "array", "items": {"$ref": "#/$defs/outcomeScope"}}},
      "additionalProperties": false
    },
    "jobStatus": {
      "type": "object",
      "required": ["job_id", "contract_version", "bundle_id", "state"],
      "properties": {
        "job_id": {"type": "string"},
        "contract_version": {"$ref": "#/$defs/contractVersion"},
        "bundle_id": {"type": "string"},
        "state": {"enum": ["queued", "running", "partial", "complete", "failed", "cancelled"]},
        "outcomes": {"type": "array", "items": {"$ref": "#/$defs/providerOutcome"}},
        "failure": {"$ref": "#/$defs/failure"}
      },
      "additionalProperties": false
    },
    "outcomeScope": {
      "type": "object",
      "required": ["provider", "category", "tile_id"],
      "properties": {"provider": {"type": "string"}, "category": {"$ref": "#/$defs/category"}, "tile_id": {"type": "string"}},
      "additionalProperties": false
    },
    "providerOutcome": {
      "type": "object",
      "required": ["provider", "category", "tile_id", "status", "pagination_exhausted", "raw_count", "deduplicated_count", "relation_members_complete", "gaps"],
      "properties": {
        "provider": {"type": "string"},
        "category": {"$ref": "#/$defs/category"},
        "tile_id": {"type": "string"},
        "status": {"$ref": "#/$defs/outcomeStatus"},
        "pagination_exhausted": {"type": "boolean"},
        "raw_count": {"type": "integer", "minimum": 0},
        "deduplicated_count": {"type": "integer", "minimum": 0},
        "relation_members_complete": {"type": "boolean"},
        "gaps": {"type": "array", "items": {"type": "string"}},
        "gap_geometry": {"$ref": "#/$defs/geometry"},
        "failure": {"$ref": "#/$defs/failure"}
      },
      "allOf": [{
        "if": {"properties": {"gaps": {"minItems": 1}}},
        "then": {"required": ["gap_geometry"]}
      }],
      "additionalProperties": false
    },
    "coverageReport": {
      "type": "object",
      "required": ["outcomes"],
      "properties": {"outcomes": {"type": "array", "items": {"$ref": "#/$defs/providerOutcome"}}},
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["code", "scope", "retryable", "explanation", "suggested_action"],
      "properties": {
        "code": {"type": "string"},
        "scope": {"type": "string"},
        "retryable": {"type": "boolean"},
        "explanation": {"type": "string"},
        "suggested_action": {"type": "string"}
      },
      "additionalProperties": false
    },
    "geometry": {
      "oneOf": [
        {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"const": "Point"}, "coordinates": {"$ref": "#/$defs/position"}}},
        {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"const": "MultiPoint"}, "coordinates": {"type": "array", "items": {"$ref": "#/$defs/position"}}}},
        {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"const": "LineString"}, "coordinates": {"type": "array", "items": {"$ref": "#/$defs/position"}}}},
        {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"const": "MultiLineString"}, "coordinates": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/position"}}}}},
        {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"const": "Polygon"}, "coordinates": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/position"}}}}},
        {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"const": "MultiPolygon"}, "coordinates": {"type": "array", "items": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/position"}}}}}}
      ]
    },
    "position": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false},
    "licence": {
      "type": "object",
      "required": ["identifier", "url", "attribution", "dataset_release", "acquired_at"],
      "properties": {
        "identifier": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "attribution": {"type": "string"},
        "dataset_release": {"type": "string"},
        "acquired_at": {"type": "string", "format": "date-time"},
        "upstream_obligations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "sourceLineage": {
      "type": "object",
      "required": ["provider", "dataset_release", "source_record_id", "source_record_version", "upstream_records", "acquired_at", "original_classification"],
      "properties": {
        "provider": {"type": "string"},
        "dataset_release": {"type": "string"},
        "source_record_id": {"type": "string"},
        "source_record_version": {"type": "string"},
        "upstream_records": {"type": "array", "items": {"type": "string"}},
        "acquired_at": {"type": "string", "format": "date-time"},
        "original_classification": {"type": "string"},
        "relation": {
          "type": "object",
          "required": ["relation_id", "assembly_status", "member_ids"],
          "properties": {"relation_id": {"type": "string"}, "assembly_status": {"const": "complete"}, "member_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sourceObservation": {
      "type": "object",
      "required": ["id", "category", "geometry", "original_properties", "lineage", "licence", "coordinate_semantics", "unit_semantics", "time_semantics", "geometry_sha256", "derivation", "review_geometry_proposal", "raw_spatial_measures", "suggestions", "attribute_provenance"],
      "properties": {
        "id": {"type": "string"},
        "category": {"$ref": "#/$defs/category"},
        "geometry": {"$ref": "#/$defs/geometry"},
        "original_properties": {"type": "object"},
        "lineage": {"$ref": "#/$defs/sourceLineage"},
        "licence": {"$ref": "#/$defs/licence"},
        "coordinate_semantics": {"type": "object", "required": ["crs", "axis_order"], "properties": {"crs": {"type": "string", "minLength": 1}, "axis_order": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "unit_semantics": {"type": "object", "additionalProperties": {"enum": ["m", "m2", "degrees", "levels", "none"]}},
        "time_semantics": {"type": "object", "required": ["dataset_release", "acquired_at"], "properties": {"dataset_release": {"type": "string"}, "acquired_at": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
        "geometry_sha256": {"$ref": "#/$defs/sha256"},
        "derivation": {
          "type": "object",
          "required": ["rule_version", "steps", "source_geometry_sha256", "review_geometry_sha256"],
          "properties": {
            "rule_version": {"type": "string"},
            "steps": {"type": "array", "items": {"type": "string"}},
            "source_geometry_sha256": {"$ref": "#/$defs/sha256"},
            "review_geometry_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "review_geometry_proposal": {"$ref": "#/$defs/geometry"},
        "raw_spatial_measures": {"type": "object", "additionalProperties": {"type": "number"}},
        "suggestions": {"type": "array", "items": {"type": "object", "required": ["kind", "rule_version", "reason"], "properties": {"kind": {"type": "string"}, "rule_version": {"type": "string"}, "reason": {"type": "string"}, "building_entity_id": {"type": "string", "minLength": 1}, "building_role": {"enum": ["whole", "part", "unclassified"]}, "boundary_relationship": {"enum": ["inside", "outside", "straddling", "unknown"]}, "overlap_group": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "attribute_provenance": {"type": "array", "items": {"$ref": "#/$defs/attributeProvenance"}}
      },
      "additionalProperties": false
    },
    "attributeProvenance": {
      "oneOf": [
        {"type": "object", "required": ["attribute", "value", "source_observation_id", "original_value", "unit", "derivation", "rule_version"], "properties": {"attribute": {"const": "height_m"}, "value": {"type": "number"}, "source_observation_id": {"type": "string"}, "original_value": {}, "unit": {"const": "m"}, "derivation": {"enum": ["direct", "derived"]}, "rule_version": {"type": "string"}}, "additionalProperties": false},
        {"type": "object", "required": ["attribute", "value", "source_observation_id", "original_value", "unit", "derivation", "rule_version"], "properties": {"attribute": {"const": "levels"}, "value": {"type": "integer", "minimum": 1}, "source_observation_id": {"type": "string"}, "original_value": {}, "unit": {"const": "levels"}, "derivation": {"enum": ["direct", "derived"]}, "rule_version": {"type": "string"}}, "additionalProperties": false},
        {"type": "object", "required": ["attribute", "value", "source_observation_id", "original_value", "unit", "derivation", "rule_version"], "properties": {"attribute": {"const": "width_m"}, "value": {"type": "number", "exclusiveMinimum": 0}, "source_observation_id": {"type": "string"}, "original_value": {}, "unit": {"const": "m"}, "derivation": {"enum": ["direct", "derived"]}, "rule_version": {"type": "string"}}, "additionalProperties": false},
        {"type": "object", "required": ["attribute", "value", "source_observation_id", "original_value", "unit", "derivation", "rule_version"], "properties": {"attribute": {"enum": ["subtype", "name"]}, "value": {"type": "string"}, "source_observation_id": {"type": "string"}, "original_value": {}, "unit": {"const": "none"}, "derivation": {"enum": ["direct", "derived"]}, "rule_version": {"type": "string"}}, "additionalProperties": false}
      ]
    },
    "assessmentDimension": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {"status": {"type": "string"}, "reason": {"type": "string"}},
      "additionalProperties": false
    },
    "coarseRasterObservation": {
      "type": "object",
      "required": ["id", "category", "subject", "linkedGapId", "datasetBundleId", "source", "grid", "algorithm", "clip", "preClipGeometry", "approximateGeometry", "inputCellCount", "retainedCellCount", "componentCellCounts", "structuredConflictObservationIds", "exclusions", "assessment", "derivedSha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"enum": ["water", "vegetation"]},
        "subject": {"enum": ["water", "vegetation", "land_cover"]},
        "linkedGapId": {"type": "string", "minLength": 1},
        "datasetBundleId": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "required": ["provider", "datasetVersion", "observedAt", "nativeResolutionMetres", "classLabel", "sourceChunkId", "sourceSha256", "licence"],
          "properties": {"provider": {"enum": ["sentinel-2-l2a", "worldcover"]}, "datasetVersion": {"type": "string"}, "observedAt": {"type": "string", "format": "date-time"}, "nativeResolutionMetres": {"type": "number", "minimum": 5}, "classLabel": {"type": "string"}, "sourceChunkId": {"type": "string"}, "sourceSha256": {"$ref": "#/$defs/sha256"}, "licence": {"$ref": "#/$defs/licence"}},
          "additionalProperties": false
        },
        "grid": {
          "type": "object",
          "required": ["crs", "affineTransform", "cloudHandling", "nodataHandling"],
          "properties": {"crs": {"type": "string"}, "affineTransform": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}}, "cloudHandling": {"type": "string"}, "nodataHandling": {"type": "string"}},
          "additionalProperties": false
        },
        "algorithm": {"$ref": "#/$defs/coarseRasterAlgorithmProfile"},
        "clip": {
          "type": "object",
          "required": ["boundaryResultSha256", "linkedGapId", "gapTileId", "gapGeometry", "clippedToBoundaryAndGap"],
          "properties": {"boundaryResultSha256": {"$ref": "#/$defs/sha256"}, "linkedGapId": {"type": "string"}, "gapTileId": {"type": "string"}, "gapGeometry": {"$ref": "#/$defs/geometry"}, "clippedToBoundaryAndGap": {"const": true}},
          "additionalProperties": false
        },
        "preClipGeometry": {"$ref": "#/$defs/geometry"},
        "approximateGeometry": {"$ref": "#/$defs/geometry"},
        "inputCellCount": {"type": "integer", "minimum": 1},
        "retainedCellCount": {"type": "integer", "minimum": 1},
        "componentCellCounts": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "structuredConflictObservationIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "exclusions": {"type": "array", "items": {"type": "object", "required": ["reason", "excludedCellCount", "structuredObservationIds", "explanation"], "properties": {"reason": {"enum": ["structured_geometry_priority", "outside_boundary_or_gap", "cloud", "no_data", "below_threshold", "below_minimum_component"]}, "excludedCellCount": {"type": "integer", "minimum": 1}, "structuredObservationIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "explanation": {"type": "string"}}, "additionalProperties": false}},
        "assessment": {"type": "object", "required": ["geometry", "semantics", "entityMatch", "nameMatch", "priority"], "properties": {"geometry": {"$ref": "#/$defs/assessmentDimension"}, "semantics": {"$ref": "#/$defs/assessmentDimension"}, "entityMatch": {"$ref": "#/$defs/assessmentDimension"}, "nameMatch": {"$ref": "#/$defs/assessmentDimension"}, "priority": {"type": "string"}}, "additionalProperties": false},
        "derivedSha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "transportChunks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "contentEncoding": "base64"}
    },
    "boundaryCandidate": {
      "type": "object",
      "required": ["id", "rank", "geometry", "lineage", "licence", "ranking_evidence"],
      "properties": {
        "id": {"type": "string"},
        "rank": {"type": "integer", "minimum": 1},
        "geometry": {"$ref": "#/$defs/geometry"},
        "lineage": {"$ref": "#/$defs/sourceLineage"},
        "licence": {"$ref": "#/$defs/licence"},
        "ranking_evidence": {
          "type": "object",
          "required": ["name_match", "distance_m", "contains_anchor", "area_m2"],
          "properties": {
            "name_match": {"type": "number", "minimum": 0, "maximum": 1},
            "distance_m": {"type": "number", "minimum": 0},
            "contains_anchor": {"type": "boolean"},
            "area_m2": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "boundaryDiscoverySnapshot": {
      "type": "object",
      "required": ["contract_version", "bundle", "candidates", "coverage_report", "transport_chunks", "manifest"],
      "properties": {
        "contract_version": {"$ref": "#/$defs/contractVersion"},
        "bundle": {"$ref": "#/$defs/datasetBundle"},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/boundaryCandidate"}},
        "coverage_report": {"$ref": "#/$defs/coverageReport"},
        "transport_chunks": {"$ref": "#/$defs/transportChunks"},
        "manifest": {"$ref": "#/$defs/fixtureManifest"}
      },
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "required": ["id", "stable_cursor", "content_type", "content_encoding", "sha256", "uncompressed_bytes"],
      "properties": {
        "id": {"type": "string"},
        "stable_cursor": {"type": "string"},
        "content_type": {"const": "application/x-ndjson"},
        "content_encoding": {"const": "gzip"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "uncompressed_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "resultManifest": {
      "type": "object",
      "required": ["contract_version", "bundle", "coverage_report", "licences", "chunks", "result_sha256"],
      "properties": {
        "contract_version": {"$ref": "#/$defs/contractVersion"},
        "bundle": {"$ref": "#/$defs/datasetBundle"},
        "coverage_report": {"$ref": "#/$defs/coverageReport"},
        "licences": {"type": "array", "items": {"$ref": "#/$defs/licence"}},
        "chunks": {"type": "array", "items": {"$ref": "#/$defs/chunk"}},
        "result_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "fixtureManifest": {
      "type": "object",
      "required": ["contract_version", "chunks", "result_sha256"],
      "properties": {
        "contract_version": {"$ref": "#/$defs/contractVersion"},
        "chunks": {"type": "array", "items": {"$ref": "#/$defs/chunk"}},
        "result_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "coarseRasterFixture": {
      "type": "object",
      "required": ["contract_version", "bundle", "coverage_report", "observations", "transport_chunks", "manifest"],
      "properties": {
        "contract_version": {"$ref": "#/$defs/contractVersion"},
        "bundle": {"$ref": "#/$defs/datasetBundle"},
        "coverage_report": {"$ref": "#/$defs/coverageReport"},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/coarseRasterObservation"}},
        "transport_chunks": {"$ref": "#/$defs/transportChunks"},
        "manifest": {"$ref": "#/$defs/fixtureManifest"}
      },
      "additionalProperties": false
    },
    "acquisitionFixture": {
      "type": "object",
      "required": ["contract_version", "bundle", "coverage_report", "observations", "transport_chunks", "manifest"],
      "properties": {
        "contract_version": {"$ref": "#/$defs/contractVersion"},
        "bundle": {"$ref": "#/$defs/datasetBundle"},
        "coverage_report": {"$ref": "#/$defs/coverageReport"},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/sourceObservation"}},
        "transport_chunks": {"$ref": "#/$defs/transportChunks"},
        "manifest": {"$ref": "#/$defs/fixtureManifest"}
      },
      "additionalProperties": false
    }
  }
}
