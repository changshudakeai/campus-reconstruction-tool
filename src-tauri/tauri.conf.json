{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Campus Reconstruction Tool",
  "version": "0.1.0",
  "identifier": "edu.ecnu.minecraft.campus-reconstruction-tool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Campus Reconstruction Tool",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
