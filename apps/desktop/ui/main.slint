// T19 — S1 薄壳主窗口（Phase1 最小壳）。
// 薄壳原则（ADR-0017）：此处零业务逻辑，只声明属性与布局；
// 全部文案由 Rust 侧经 B6 l10n 注入（文本外置铁律 ADR-0005），
// .slint 内不得出现硬编码的用户可见文字。

export component AppWindow inherits Window {
    // 窗口标题与着陆状态文案，均由壳的 Rust 侧填充
    in property <string> app-title;
    in property <string> status-text;

    title: root.app-title;
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 480px;
    min-height: 320px;

    VerticalLayout {
        alignment: center;

        Text {
            text: root.status-text;
            horizontal-alignment: center;
            font-size: 16px;
            wrap: word-wrap;
        }
    }
}
