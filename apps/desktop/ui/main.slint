// ignore-tidy-filelength: 主窗口单文件承载全部页面布局与接线声明（T19B 系列骨架设计），拆分需先立 UI 重构工单
// T19 — S1 薄壳主窗口。
// 薄壳原则（ADR-0017）：此处零业务逻辑，只声明属性与布局；
// 全部文案由 Rust 侧经 B6 l10n 注入（文本外置铁律 ADR-0005），
// .slint 内不得出现硬编码的用户可见文字。
// T19B-5A：色卡角色名替换（ADR-0023）+ 通用对话框基建 + ADR-0010/0018 还债。
// 颜色一律引用 Theme 角色名（ADR-0023），零硬编码颜色号。

import { Button, ComboBox, GroupBox, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SettingsWizard } from "settings_wizard.slint";
import { CampusSelect, CampusData } from "campus_select.slint";
import { PlanList, PlanCardData } from "plan_list.slint";
import { ConfirmDialog, InputDialog } from "dialogs.slint";
import { NoticeBoard, NoticeData } from "notice_board.slint";
import { Trash, TrashItemData } from "trash.slint";
import { Stepper } from "stepper.slint";
import { BoundaryPointData } from "boundary_edit.slint";
import { OrientationPointData } from "orientation.slint";
import { WorkspaceDrawer } from "workspace_drawer.slint";
import { ReviewDrawer, ReviewCandidateData } from "review.slint";

// 重新导出 Theme global 供 Rust 侧访问（ADR-0023 色卡机制）
export { Theme }
export { OrientationPointData }

export enum OperationPresentationState {
    ready,
    succeeded,
    processing,
    failed,
    needs-confirmation,
    needs-input,
}

export component AppWindow inherits Window {
    // 路由屏号：0 = 首跑向导，1 = 校区选择，2 = 方案列表，3 = 设置页
    in-out property <int> active-screen: 1;

    // 窗口标题与着陆状态文案，均由壳的 Rust 侧填充
    in property <string> app-title;
    in property <string> status-text;
    in property <OperationPresentationState> operation-state: OperationPresentationState.ready;
    in property <int> operation-progress: 0;
    in property <OperationPresentationState> diagnostic-operation-state: OperationPresentationState.ready;
    in property <int> diagnostic-operation-progress: 0;

    // ── 首跑向导（属性直通 SettingsWizard，值全部来自 Rust 侧）──
    in property <string> wizard-title;
    in property <string> wizard-language-label;
    in property <string> wizard-version-label;
    in property <string> wizard-notice-text;
    in property <string> wizard-continue-label;
    in property <[string]> wizard-language-options;
    in property <[string]> wizard-version-options;
    in-out property <string> wizard-language;
    in-out property <string> wizard-version;
    in-out property <bool> wizard-acknowledged;

    // ── 设置页（债务②：F2 规矩④"重新查看教程"入口）──
    in property <string> settings-title;
    in property <string> settings-back-label;
    in property <string> tutorial-replay-label;

    // ── T22: 高德地图密钥设置属性─────────────────────
    in property <string> gaode-group-title;
    in property <string> gaode-api-key-label;
    in property <string> gaode-api-key-placeholder;
    in-out property <string> gaode-api-key;
    in property <string> gaode-security-key-label;
    in property <string> gaode-security-key-placeholder;
    in-out property <string> gaode-security-key;
    in property <string> gaode-web-service-key-label;
    in property <string> gaode-web-service-key-placeholder;
    in-out property <string> gaode-web-service-key;
    in property <string> gaode-save-button-label;
    in property <string> gaode-test-button-label;
    in property <string> gaode-status-message;
    callback gaode-save-clicked();
    callback gaode-test-clicked();

    // ── 设置页：常规设置（ADR-0004 语言/版本/默认导出位置）──
    in property <string> settings-general-group-title;
    in property <string> settings-language-label;
    in property <[string]> settings-language-options;
    in-out property <string> settings-language;
    in property <string> settings-version-label;
    in property <[string]> settings-version-options;
    in-out property <string> settings-version;
    in property <string> settings-export-location-label;
    in property <string> settings-export-location-placeholder;
    in-out property <string> settings-export-location;
    in property <string> settings-save-button-label;
    in property <string> gaode-clear-button-label;
    callback settings-save-clicked();
    callback gaode-clear-clicked();

    // ── 右上角工具栏（ADR-0027 §决定 - 四入口固定）───────────────
    // 可见性由 active-screen 派生（屏 2/4/5/6 显示，0/1/3 隐藏），无需 Rust 注入
    in property <string> toolbar-title;
    // 四个图标按钮：公告栏 / 切换校区 / 回收站 / 设置
    in property <bool> notice-toolbar-button-visible;
    in property <string> notice-toolbar-label;
    // B7 铃铛未读角标（ADR-0021：点开即清零）
    in property <int> notice-unread-count;
    in property <bool> switch-campus-toolbar-button-visible;
    in property <string> switch-campus-toolbar-label;
    in property <bool> trash-toolbar-button-visible;
    in property <string> trash-toolbar-label;
    in property <bool> settings-toolbar-button-visible;
    in property <string> settings-toolbar-label;
    
    // ── 屏 5：公告栏页属性（T19B-9 新增）────────────
    in property <string> notice-board-title;
    in property <string> notice-board-empty-list-text;
    in property <string> notice-board-archive-button-text;
    in property <string> notice-board-date-today;
    in property <string> notice-board-date-yesterday;
    in property <string> notice-board-importance-high-label;
    in property <string> notice-board-unread-marker;
    in property <string> notice-board-diagnostic-action-label;
    in property <[NoticeData]> notice-board-model;
    callback notice-diagnostic-action-clicked(notification-id: string);
    // B7 普通提示 toast（ADR-0021：短暂弹出自动消失）
    in property <string> toast-title;
    in property <string> toast-body;
    in-out property <bool> toast-visible;

    in property <string> trash-page-title;
    in property <string> trash-page-empty-list-text;
    in property <string> trash-page-restore-button-text;
    in property <string> trash-page-purge-button-text;
    in property <string> trash-page-retention-notice-text;
    in property <string> trash-page-campus-prefix;
    in property <[TrashItemData]> trash-page-model;
    
    in-out property <int> workspace-active-step: 0;  // 当前步骤索引
    in-out property <int> workspace-completed-steps: 0;  // 已完成步数
    in property <string> workspace-placeholder-title;
    in property <string> workspace-placeholder-subtitle;
    in property <string> workspace-step-pending-notice;
    in property <string> workspace-stepper-title-label;
    in property <string> workspace-stepper-boundary-label;
    in property <string> workspace-stepper-orientation-label;
    in property <string> workspace-stepper-collection-label;
    in property <string> workspace-stepper-review-label;
    in property <string> workspace-stepper-export-label;
    in property <string> workspace-back-to-plan-list-label;
    in property <string> workspace-export-start-label;
    // T34: 左侧抽屉（做法 A：展开时地图右移让位；收起时恢复原宽）
    in-out property <bool> workspace-drawer-open: false;
    in property <length> workspace-drawer-width: 300px;
    // T34: 地图 WebView 是否可用（不可用时边界步骤显示 Slint 兜底画布）
    in property <bool> workspace-map-available: true;
    // T36：地图加载中/失败占位（步骤②地图不可用时不得面对无声空白）
    in property <bool> workspace-map-loading: false;
    in property <string> workspace-map-loading-label;
    in property <string> workspace-map-failed-label;
    // T34: 地图槽位由 Slint 布局计算并上报（逻辑像素）——不再硬编码坐标；
    // map_webview 轮询这些属性经 set_bounds 跟随（含抽屉开合让位）。
    in property <length> workspace-map-slot-x: 20px + (root.workspace-drawer-open ? root.workspace-drawer-width + 12px : 0px);
    in property <length> workspace-map-slot-y: 128px;
    in property <length> workspace-map-slot-width: max(0px, root.width - root.workspace-map-slot-x - 16px);
    in property <length> workspace-map-slot-height: max(0px, root.height - root.workspace-map-slot-y - 16px);
    in property <string> workspace-boundary-points-label;
    in property <string> workspace-orientation-current-angle-label;
    in property <string> workspace-orientation-confirm-two-points-label;
    in property <string> workspace-drawer-expand-tooltip;
    in property <string> workspace-drawer-collapse-tooltip;
    // ADR-0027：五个步骤顶部始终同时显示校区名与方案名（合成文案由 Rust 侧注入）
    in property <string> workspace-campus-name;
    in property <string> workspace-plan-name;
    in property <string> workspace-context-label;
    // 步骤锁定与完成状态由功能入口注入（S1 不自行判断步骤门控）
    in property <[bool]> workspace-step-locked;
    in property <[bool]> workspace-step-completed;
    // 步骤条教程气泡 (F2 钩子，ADR-0028 三泡之二)
    in property <bool> workspace-tutorial-visible;
    in property <string> workspace-tutorial-text;
    in property <string> workspace-tutorial-dismiss-label;
    in property <string> workspace-tutorial-skip-all-label;
    callback workspace-step-clicked(step-index: int);
    callback workspace-back-to-plan-list-clicked();
    callback workspace-tutorial-dismiss-clicked();
    callback workspace-tutorial-skip-all-clicked();
    // 地图加载完成状态（成功/故障；S1 只呈现，不判断地图业务规则）
    callback workspace-map-status-changed(available: bool);
    // 地图 WebView 转交的原始 IPC 消息（由工作区功能入口解析）
    callback workspace-map-ipc(message: string);
    // T34: 左侧抽屉开合（左缘箭头）
    callback workspace-drawer-toggle-clicked();
        
    // ── 屏 4 步骤①：圈边界编辑器属性（T19B-5B Phase 2 Step A）────────
    in property <[BoundaryPointData]> workspace-boundary-points;
    in property <string> workspace-boundary-path-commands;
    in property <string> workspace-boundary-title;
    in property <string> workspace-boundary-hint;
    in property <string> workspace-boundary-undo-label;
    in property <string> workspace-boundary-confirm-label;
    in property <string> workspace-boundary-reset-label;
    in property <string> workspace-boundary-refresh-label;
    in property <string> workspace-boundary-status;
    in property <string> workspace-boundary-map-placeholder;
    in property <bool> workspace-boundary-is-determined;
    in property <int> workspace-boundary-point-count;
        callback workspace-boundary-canvas-clicked(x: float, y: float);
    callback workspace-boundary-undo-clicked();
    callback workspace-boundary-confirm-clicked();
    callback workspace-boundary-reset-clicked();
    callback workspace-boundary-refresh-clicked();

    // ── 屏 4 步骤②：定朝向交互页属性（T19B-5B Phase 2 Step B）────────
        in property <[OrientationPointData]> workspace-orientation-points;
    in property <string> workspace-orientation-path-commands;
    // P1-5: 方向箭头 Path commands
    in property <string> workspace-orientation-arrow-commands;
    // P1-4: 朝向模式改 in-out 供 Shell 切换
    in-out property <string> workspace-orientation-mode: "two-points";
    in property <float> workspace-orientation-angle: -1.0;
    in property <bool> workspace-orientation-is-determined;
    in property <string> workspace-orientation-title;
    in property <string> workspace-orientation-two-points-hint;
    in property <string> workspace-orientation-bearing-angle-hint;
    in property <string> workspace-orientation-angle-input-placeholder;
        in property <string> workspace-orientation-angle-display;
    in-out property <string> workspace-orientation-input-text;
    in property <string> workspace-orientation-submit-label;
    in property <string> workspace-orientation-reset-label;
    in property <string> workspace-orientation-status;
    callback workspace-orientation-confirm-two-points-clicked();
    callback workspace-orientation-submit-clicked();
    callback workspace-orientation-reset-clicked();

    in property <string> collection-source-label;
    in property <string> collection-collect-label;
    in property <string> collection-progress-label;
    in property <[string]> collection-category-labels;
    in property <[string]> collection-category-statuses;
    in property <string> collection-category-skip-label;
    in property <string> collection-diff-summary;
    in property <string> collection-report-entry-label;
    in property <string> collection-report-body;
    in property <string> collection-stage-label;
    in property <string> collection-elapsed-label;
    in property <string> collection-cancel-label;
    in property <bool> collection-cancel-visible;
    in property <string> collection-partial-naming-label;
    callback collection-start-clicked();
    callback collection-report-clicked();
    callback collection-cancel-clicked();
    // M3 评审页（F5 呈现层）
    in property <string> review-title;
    in property <string> review-empty-text;
    in property <int> review-candidate-count;
    in property <[string]> review-category-labels;
    in property <[int]> review-category-counts;
    in property <int> review-active-category;
    in property <[ReviewCandidateData]> review-cards;
    // T39 分页：当前页切片 + 页码/翻页按钮（Slint 无虚拟化，50–100/页）。
    in property <int> review-page-size;
    in property <int> review-page-index;
    in property <int> review-page-total;
    in property <string> review-page-label;
    in property <string> review-page-prev-label;
    in property <string> review-page-next-label;
    in property <string> review-selected-count-label;
    in property <bool> review-bulk-buttons-visible;
    in property <string> review-set-keep-label;
    in property <string> review-set-reject-label;
    in property <string> review-set-pending-label;
    in property <string> review-select-all-label;
    in property <string> review-deselect-all-label;
    in property <string> review-card-pending-label;
    in property <string> review-card-keep-label;
    in property <string> review-card-reject-label;
    in property <string> review-pause-label;
    in property <string> review-resume-label;
    in property <string> review-seal-label;
    in property <bool> review-sealed;
    in property <bool> review-summary-visible;
    in property <string> review-summary-text;
    // T38 抽屉：选中候选详情（名称/类别/标签与属性/来源/状态）
    in property <bool> review-detail-visible;
    in property <string> review-detail-title;
    in property <string> review-detail-category-label;
    in property <string> review-detail-tags-label;
    in property <[string]> review-detail-tags;
    in property <string> review-detail-source-label;
    in property <string> review-detail-source;
    in property <string> review-detail-state-label;
    // T38：卡片"定位到地图"按钮文案
    in property <string> review-locate-label;
    // 地图三态/选中图例（虚线=待定、实线=保留、红色轮廓=选中/定位）
    in property <string> review-legend;
    // T33 契约观测：评审候选列表滚动（大量候选下操作栏可达）。只读布局观测，
    // 不参与评审/封账逻辑；由 ReviewView 内部几何经双向绑定上联。
    in-out property <length> review-list-viewport-y;
    callback review-category-clicked(index: int);
    callback review-page-prev-clicked();
    callback review-page-next-clicked();
    callback review-card-highlight-clicked(candidate-id: string);
    callback review-card-state-clicked(candidate-id: string, state: string);
    callback review-card-selection-toggled(candidate-id: string);
    callback review-locate-clicked(candidate-id: string);
    callback review-select-all-clicked();
    callback review-deselect-all-clicked();
    callback review-bulk-state-clicked(state: string);
    callback review-pause-clicked();
    callback review-resume-clicked();
    callback review-seal-clicked();
    callback workspace-export-start-clicked();

    // ── B7 错误模态弹窗（弹窗铁律 ADR-0021，内容由 ShellPresenter 填充）──
    in-out property <bool> error-dialog-visible;
    in property <string> error-dialog-title;
    in property <string> error-dialog-source;
    in property <string> error-dialog-body;
    in property <string> error-dialog-ok-label;
    in property <bool> error-dialog-diagnostic-action-visible;
    in property <string> error-dialog-notification-id;
    in property <string> error-dialog-diagnostic-action-label;
    in property <bool> error-dialog-retry-visible;
    in property <string> error-dialog-retry-label;

    // ── 通用确认窗（T19B-5A 对话框基建）──────────────────────
    in-out property <bool> confirm-dialog-visible;
    in property <string> confirm-dialog-title;
    in property <string> confirm-dialog-body;
    in property <string> confirm-dialog-confirm-label;
    in property <string> confirm-dialog-cancel-label;

    // ── 通用输入窗（T19B-5A 对话框基建）──────────────────────
    in-out property <bool> input-dialog-visible;
    in property <string> input-dialog-title;
    in property <string> input-dialog-label;
    in-out property <string> input-dialog-text;
    in property <string> input-dialog-confirm-label;
    in property <string> input-dialog-cancel-label;
    // 输入窗模式：0 = 新建方案，1 = 改名（Rust 侧据此分派回调逻辑）
    in-out property <int> input-dialog-mode;
    // 当前操作的方案 ID（改名/删除时由 Rust 侧填入）
    in-out property <string> active-plan-id;

    in property <string> campus-select-title;
    in property <string> campus-select-empty-list-text;
    in property <string> campus-select-settings-button-text;
    in property <[CampusData]> campus-select-model;
    in-out property <string> campus-search-text;
    in property <string> campus-search-placeholder;
    in property <string> campus-search-button-text;
    in property <string> campus-recent-title;
    in property <string> campus-search-status;
    in property <[CampusData]> campus-search-results-model;
    in property <bool> campus-show-results;

    callback campus-select-settings-clicked();
    callback campus-select-campus-clicked(campus-id: string);
    callback campus-search-requested();
    callback campus-select-remove-recent-clicked(campus-id: string);

    in property <string> plan-list-title;
    in property <string> plan-list-campus-name;
    in property <string> plan-list-create-button-text;
    in property <string> plan-list-back-button-text;
    in property <string> plan-list-empty-text;
    in property <string> plan-list-rename-label;
    in property <string> plan-list-duplicate-label;
    in property <string> plan-list-delete-label;
    in property <[PlanCardData]> plan-list-model;
    in property <bool> plan-list-tutorial-visible;
    in property <string> plan-list-tutorial-text;
    in property <string> plan-list-tutorial-dismiss-label;
    in property <string> plan-list-tutorial-skip-all-label;

    callback plan-list-create-clicked();
    callback plan-list-back-clicked();
    // 单击方案卡片 → 直接打开工作区（ADR-0027 第 6 轮：单击即开，无概览层）
    callback plan-list-card-clicked(plan-id: string);
    callback plan-list-rename-clicked(plan-id: string);
    callback plan-list-duplicate-clicked(plan-id: string);
    callback plan-list-delete-clicked(plan-id: string);
    callback plan-list-tutorial-dismiss-clicked();
    callback plan-list-tutorial-skip-all-clicked();

    callback confirm-dialog-confirmed();
    callback confirm-dialog-cancelled();
    callback input-dialog-confirmed();
    callback input-dialog-cancelled();

    callback wizard-continue-clicked();
    callback replay-tutorial-clicked();
    callback settings-back-clicked();
    callback error-dialog-dismissed();
    callback error-dialog-diagnostic-action-clicked(notification-id: string);
    callback error-dialog-retry-clicked();
    callback diagnostic-actions-completed();
    callback settings-clicked();
    // ── T19B-9: 右上角工具栏回调 ─────────────────────
    callback notice-toolbar-button-clicked();
    callback switch-campus-toolbar-button-clicked();
    callback trash-toolbar-button-clicked();
    callback settings-toolbar-button-clicked();
    callback trash-restore-clicked(plan-id: string);
    callback trash-purge-clicked(plan-id: string);
    callback trash-purge-all-clicked();

    title: root.app-title;
    // femtovg 渲染器的默认字体缺部分中文字形（显示方块），显式指定
    // 微软雅黑（Windows 系统自带，开发版目标平台 ADR-0014）
    default-font-family: "Microsoft YaHei";
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 480px;
    min-height: 360px;
    
    
    if root.operation-state == OperationPresentationState.processing || root.diagnostic-operation-state == OperationPresentationState.processing: Text {
        x: parent.width - 72px;
        y: 60px;
        text: (root.diagnostic-operation-state == OperationPresentationState.processing
            ? root.diagnostic-operation-progress
            : root.operation-progress) + "%";
        color: Theme.text-secondary;
        font-size: 12px;
    }

    // 屏 0：首跑向导（ADR-0004：即使下拉各只有一个选项也照常显示）
    if root.active-screen == 0: SettingsWizard {
        wizard-title: root.wizard-title;
        language-label: root.wizard-language-label;
        version-label: root.wizard-version-label;
        notice-text: root.wizard-notice-text;
        continue-label: root.wizard-continue-label;
        language-options: root.wizard-language-options;
        version-options: root.wizard-version-options;
        selected-language <=> root.wizard-language;
        selected-version <=> root.wizard-version;
        acknowledged <=> root.wizard-acknowledged;
        continue-clicked => {
            root.wizard-continue-clicked();
        }
    }

    if root.active-screen == 1: CampusSelect {
        title <=> root.campus-select-title;
        empty-list-text <=> root.campus-select-empty-list-text;
        settings-button-text <=> root.campus-select-settings-button-text;
        campus-model <=> root.campus-select-model;
        search-text <=> root.campus-search-text;
        search-placeholder: root.campus-search-placeholder;
        search-button-text: root.campus-search-button-text;
        recent-title: root.campus-recent-title;
        search-status: root.campus-search-status;
        result-model <=> root.campus-search-results-model;
        show-results: root.campus-show-results;

        settings-clicked => { root.campus-select-settings-clicked() }
        campus-clicked(id) => { root.campus-select-campus-clicked(id) }
        search-requested => { root.campus-search-requested() }
        remove-recent-clicked(id) => { root.campus-select-remove-recent-clicked(id) }
    }

    if root.active-screen == 2: PlanList {
        title: root.plan-list-title;
        campus-name: root.plan-list-campus-name;
        create-button-text: root.plan-list-create-button-text;
        back-button-text: root.plan-list-back-button-text;
        empty-list-text: root.plan-list-empty-text;
        rename-label: root.plan-list-rename-label;
        duplicate-label: root.plan-list-duplicate-label;
        delete-label: root.plan-list-delete-label;
        plan-model: root.plan-list-model;
        tutorial-bubble-visible: root.plan-list-tutorial-visible;
        tutorial-bubble-text: root.plan-list-tutorial-text;
        tutorial-dismiss-label: root.plan-list-tutorial-dismiss-label;
        tutorial-skip-all-label: root.plan-list-tutorial-skip-all-label;

        create-plan-clicked => { root.plan-list-create-clicked() }
        back-to-campus-clicked => { root.plan-list-back-clicked() }
        card-clicked(id) => { root.plan-list-card-clicked(id) }
        rename-plan-clicked(id) => { root.plan-list-rename-clicked(id) }
        duplicate-plan-clicked(id) => { root.plan-list-duplicate-clicked(id) }
        delete-plan-clicked(id) => { root.plan-list-delete-clicked(id) }
        tutorial-dismiss-clicked => { root.plan-list-tutorial-dismiss-clicked() }
        tutorial-skip-all-clicked => { root.plan-list-tutorial-skip-all-clicked() }
    }


    if root.active-screen == 3: VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 32px;

        Text {
            text: root.settings-title;
            horizontal-alignment: center;
            font-size: 20px;
            color: Theme.text-primary;
        }

        HorizontalLayout {
            alignment: center;

            Button {
                text: root.tutorial-replay-label;
                clicked => {
                    root.replay-tutorial-clicked();
                }
            }
        }

        HorizontalLayout {
            alignment: center;

            Button {
                text: root.settings-back-label;
                clicked => {
                    root.settings-back-clicked();
                }
            }
        }

        // 常规设置（ADR-0004：语言、Minecraft 版本、默认导出位置）
        GroupBox {
            title: root.settings-general-group-title;
            preferred-width: 450px;

            VerticalLayout {
                spacing: 16px;

                HorizontalLayout {
                    alignment: start;
                    spacing: 12px;

                    Text {
                        text: root.settings-language-label;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        width: 100px;
                    }

                    ComboBox {
                        model: root.settings-language-options;
                        current-value <=> root.settings-language;
                        preferred-width: 240px;
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: 12px;

                    Text {
                        text: root.settings-version-label;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        width: 100px;
                    }

                    ComboBox {
                        model: root.settings-version-options;
                        current-value <=> root.settings-version;
                        preferred-width: 240px;
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: 12px;

                    Text {
                        text: root.settings-export-location-label;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        width: 100px;
                    }

                    LineEdit {
                        text <=> root.settings-export-location;
                        placeholder-text: root.settings-export-location-placeholder;
                        preferred-width: 240px;
                    }
                }

                HorizontalLayout {
                    alignment: end;

                    Button {
                        text: root.settings-save-button-label;
                        primary: true;
                        clicked => {
                            root.settings-save-clicked();
                        }
                    }
                }
            }
        }

        // T22: 高德地图密钥配置卡片
        GroupBox {
            title: root.gaode-group-title;
            preferred-width: 450px;

            VerticalLayout {
                spacing: 16px;

                // API Key 输入行
                HorizontalLayout {
                    alignment: start;
                    spacing: 12px;

                    Text {
                        text: root.gaode-api-key-label;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        width: 100px;
                    }

                    LineEdit {
                        text <=> root.gaode-api-key;
                        placeholder-text: root.gaode-api-key-placeholder;
                        preferred-width: 240px;
                    }
                }

                // 安全密钥输入行（Slint 1.17.1 不支持 echo-mode: Password）
                HorizontalLayout {
                    alignment: start;
                    spacing: 12px;

                    Text {
                        text: root.gaode-security-key-label;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        width: 100px;
                    }

                    LineEdit {
                        text <=> root.gaode-security-key;
                        placeholder-text: root.gaode-security-key-placeholder;
                        preferred-width: 240px;
                    }
                }

                // 高德 Web 服务 Key（T31 regeo 补名；ADR-0004 开发人员使用，可留空）
                HorizontalLayout {
                    alignment: start;
                    spacing: 12px;

                    Text {
                        text: root.gaode-web-service-key-label;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        width: 100px;
                    }

                    LineEdit {
                        text <=> root.gaode-web-service-key;
                        placeholder-text: root.gaode-web-service-key-placeholder;
                        preferred-width: 240px;
                    }
                }

                // 保存/测试按钮行
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: root.gaode-save-button-label;
                        primary: true;
                        enabled: root.gaode-api-key != "" && root.gaode-security-key != "";
                        clicked => { 
                            root.gaode-save-clicked(); 
                        }
                    }

                    Button {
                        text: root.gaode-test-button-label;
                        enabled: root.gaode-api-key != "" && root.gaode-security-key != "";
                        clicked => { 
                            root.gaode-test-clicked(); 
                        }
                    }
                }

                // 清除全部高德密钥（ADR-0004：先确认，后一次清除）
                HorizontalLayout {
                    alignment: center;

                    Button {
                        text: root.gaode-clear-button-label;
                        clicked => {
                            root.gaode-clear-clicked();
                        }
                    }
                }

                // 状态提示
                Text {
                    text: root.gaode-status-message;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    preferred-height: 20px;
                }
            }
        }
    }

    // ── 屏 4：方案工作区（T19B-5B）──────────────────────
    if root.active-screen == 4: Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.surface;
    
        // 顶部步骤条
        Stepper {
            x: 16px;
            y: 64px;
            active-step: root.workspace-active-step;
            step-locked: root.workspace-step-locked;
            step-completed: root.workspace-step-completed;
            stepper-title-label: root.workspace-stepper-title-label;
            stepper-context-label: root.workspace-context-label;
            stepper-boundary-label: root.workspace-stepper-boundary-label;
            stepper-orientation-label: root.workspace-stepper-orientation-label;
            stepper-collection-label: root.workspace-stepper-collection-label;
            stepper-review-label: root.workspace-stepper-review-label;
            stepper-export-label: root.workspace-stepper-export-label;
            step-clicked(index) => { 
                root.workspace-step-clicked(index);
            }
        }
    
            // T34/T38: 五个步骤全部 = 地图主画面 + 左侧可收拉抽屉（做法 A：
            // 地图让位）；步骤 ④ 评审使用评审抽屉（候选标注/定位/联动高亮）。
            Rectangle {
                // 左缘收拉箭头（常驻；点击开合抽屉）
                Rectangle {
                    x: 0px;
                    y: root.workspace-map-slot-y;
                    width: 20px;
                    height: root.workspace-map-slot-height;
                    background: Theme.surface;
                    Text {
                        text: root.workspace-drawer-open ? "◂" : "▸";
                        font-size: 16px;
                        color: Theme.text-primary;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.workspace-drawer-toggle-clicked(); }
                    }
                }

                // 左侧抽屉（展开时显示；内容按步骤；评审步用评审抽屉）
                if root.workspace-drawer-open && root.workspace-active-step == 3: ReviewDrawer {
                    x: 20px;
                    y: root.workspace-map-slot-y;
                    width: root.workspace-drawer-width;
                    height: root.workspace-map-slot-height;
                    title: root.review-title;
                    empty-text: root.review-empty-text;
                    candidate-count: root.review-candidate-count;
                    category-labels: root.review-category-labels;
                    category-counts: root.review-category-counts;
                    active-category: root.review-active-category;
                    cards: root.review-cards;
                    page-size: root.review-page-size;
                    page-index: root.review-page-index;
                    page-total: root.review-page-total;
                    page-label: root.review-page-label;
                    page-prev-label: root.review-page-prev-label;
                    page-next-label: root.review-page-next-label;
                    selected-count-label: root.review-selected-count-label;
                    bulk-buttons-visible: root.review-bulk-buttons-visible;
                    detail-visible: root.review-detail-visible;
                    detail-title: root.review-detail-title;
                    detail-category-label: root.review-detail-category-label;
                    detail-tags-label: root.review-detail-tags-label;
                    detail-tags: root.review-detail-tags;
                    detail-source-label: root.review-detail-source-label;
                    detail-source: root.review-detail-source;
                    detail-state-label: root.review-detail-state-label;
                    set-keep-label: root.review-set-keep-label;
                    set-reject-label: root.review-set-reject-label;
                    set-pending-label: root.review-set-pending-label;
                    select-all-label: root.review-select-all-label;
                    deselect-all-label: root.review-deselect-all-label;
                    card-pending-label: root.review-card-pending-label;
                    card-keep-label: root.review-card-keep-label;
                    card-reject-label: root.review-card-reject-label;
                    locate-label: root.review-locate-label;
                    legend: root.review-legend;
                    pause-label: root.review-pause-label;
                    resume-label: root.review-resume-label;
                    seal-label: root.review-seal-label;
                    sealed: root.review-sealed;
                    summary-visible: root.review-summary-visible;
                    summary-text: root.review-summary-text;
                    list-viewport-y <=> root.review-list-viewport-y;
                    category-clicked(index) => { root.review-category-clicked(index); }
                    page-prev-clicked => { root.review-page-prev-clicked(); }
                    page-next-clicked => { root.review-page-next-clicked(); }
                    card-highlight-clicked(candidate-id) => { root.review-card-highlight-clicked(candidate-id); }
                    card-state-clicked(candidate-id, state) => { root.review-card-state-clicked(candidate-id, state); }
                    card-selection-toggled(candidate-id) => { root.review-card-selection-toggled(candidate-id); }
                    locate-clicked(candidate-id) => { root.review-locate-clicked(candidate-id); }
                    select-all-clicked => { root.review-select-all-clicked(); }
                    deselect-all-clicked => { root.review-deselect-all-clicked(); }
                    bulk-state-clicked(state) => { root.review-bulk-state-clicked(state); }
                    pause-clicked => { root.review-pause-clicked(); }
                    resume-clicked => { root.review-resume-clicked(); }
                    seal-clicked => { root.review-seal-clicked(); }
                }
                if root.workspace-drawer-open && root.workspace-active-step != 3: WorkspaceDrawer {
                    x: 20px;
                    y: root.workspace-map-slot-y;
                    width: root.workspace-drawer-width;
                    height: root.workspace-map-slot-height;
                    active-step: root.workspace-active-step;
                    boundary-point-count: root.workspace-boundary-point-count;
                    boundary-points-label: root.workspace-boundary-points-label;
                    boundary-status: root.workspace-boundary-status;
                    boundary-is-determined: root.workspace-boundary-is-determined;
                    boundary-undo-label: root.workspace-boundary-undo-label;
                    boundary-reset-label: root.workspace-boundary-reset-label;
                    boundary-refresh-label: root.workspace-boundary-refresh-label;
                    boundary-confirm-label: root.workspace-boundary-confirm-label;
                    boundary-undo-clicked => { root.workspace-boundary-undo-clicked(); }
                    boundary-reset-clicked => { root.workspace-boundary-reset-clicked(); }
                    boundary-refresh-clicked => { root.workspace-boundary-refresh-clicked(); }
                    boundary-confirm-clicked => { root.workspace-boundary-confirm-clicked(); }
                    orientation-angle: root.workspace-orientation-angle;
                    orientation-angle-display: root.workspace-orientation-angle-display;
                    orientation-current-angle-label: root.workspace-orientation-current-angle-label;
                    orientation-arrow-commands: root.workspace-orientation-arrow-commands;
                    orientation-is-determined: root.workspace-orientation-is-determined;
                    orientation-status: root.workspace-orientation-status;
                    orientation-input-text <=> root.workspace-orientation-input-text;
                    orientation-angle-input-placeholder: root.workspace-orientation-angle-input-placeholder;
                    orientation-submit-label: root.workspace-orientation-submit-label;
                    orientation-confirm-two-points-label: root.workspace-orientation-confirm-two-points-label;
                    orientation-reset-label: root.workspace-orientation-reset-label;
                    orientation-submit-clicked => { root.workspace-orientation-submit-clicked(); }
                    orientation-confirm-two-points-clicked => { root.workspace-orientation-confirm-two-points-clicked(); }
                    orientation-reset-clicked => { root.workspace-orientation-reset-clicked(); }
                    collection-source-label: root.collection-source-label;
                    collection-collect-label: root.collection-collect-label;
                    collection-progress-label: root.collection-progress-label;
                    collection-category-labels: root.collection-category-labels;
                    collection-category-statuses: root.collection-category-statuses;
                    collection-category-skip-label: root.collection-category-skip-label;
                    collection-diff-summary: root.collection-diff-summary;
                    collection-report-entry-label: root.collection-report-entry-label;
                    collection-report-body: root.collection-report-body;
                    collection-stage-label: root.collection-stage-label;
                    collection-elapsed-label: root.collection-elapsed-label;
                    collection-cancel-label: root.collection-cancel-label;
                    collection-cancel-visible: root.collection-cancel-visible;
                    collection-partial-naming-label: root.collection-partial-naming-label;
                    collection-start-clicked => { root.collection-start-clicked(); }
                    collection-report-clicked => { root.collection-report-clicked(); }
                    collection-cancel-clicked => { root.collection-cancel-clicked(); }
                    export-start-label: root.workspace-export-start-label;
                    export-status-title: root.workspace-placeholder-title;
                    export-status-body: root.workspace-placeholder-subtitle;
                    export-can-start: root.workspace-boundary-is-determined;
                    export-start-clicked => { root.workspace-export-start-clicked(); }
                }

                // 地图槽位兜底画布（仅边界步骤且地图不可用时显示；
                // 地图可用时由 WebView 占据同一槽位）
                if root.workspace-active-step == 0 && !root.workspace-map-available: Rectangle {
                    x: root.workspace-map-slot-x;
                    y: root.workspace-map-slot-y;
                    width: root.workspace-map-slot-width;
                    height: root.workspace-map-slot-height;
                    background: Theme.surface;
                    border-color: Theme.separator;
                    border-width: 1px;
                    border-radius: 4px;
                    clip: true;
                    Path {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        stroke: Theme.separator;
                        stroke-width: 2px;
                        fill: transparent;
                        commands: root.workspace-boundary-path-commands;
                    }
                    for point[i] in root.workspace-boundary-points: Rectangle {
                        x: point.x * 1px;
                        y: point.y * 1px;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: {
                            if i == 0 && root.workspace-boundary-point-count > 0 {
                                Theme.error
                            } else {
                                Theme.text-primary
                            }
                        };
                        border-color: Theme.surface;
                        border-width: 1px;
                    }
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => {
                            root.workspace-boundary-canvas-clicked(self.mouse-x / 1px, self.mouse-y / 1px);
                        }
                    }
                }

                // T36：步骤②/③（非边界、非评审）地图不可用时显示明确占位，
                // 不得面对无声空白；加载中显示"地图加载中…"，失败提示可退回
                // 左侧抽屉"方位角手动输入"完成朝向。
                if root.workspace-active-step != 0 && !root.workspace-map-available: Rectangle {
                    x: root.workspace-map-slot-x;
                    y: root.workspace-map-slot-y;
                    width: root.workspace-map-slot-width;
                    height: root.workspace-map-slot-height;
                    background: Theme.surface;
                    border-color: Theme.separator;
                    border-width: 1px;
                    border-radius: 4px;
                    VerticalLayout {
                        padding: 16px;
                        Text {
                            text: root.workspace-map-loading ? root.workspace-map-loading-label : root.workspace-map-failed-label;
                            font-size: 14px;
                            color: root.workspace-map-loading ? Theme.text-secondary : Theme.error;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

        // 步骤条教程气泡 (F2 钩子，ADR-0028)——只在首次进入时显示
        if root.workspace-tutorial-visible: Rectangle {
            x: parent.width - 316px;
            y: 72px;
            width: 300px;
            height: workspace-bubble-layout.preferred-height + 24px;
            background: Theme.bubble-background;
            border-radius: 8px;
            border-color: Theme.bubble-border;
            border-width: 1px;
    
            workspace-bubble-layout := VerticalLayout {
                padding: 12px;
                spacing: 8px;
    
                Text {
                    text: root.workspace-tutorial-text;
                    font-size: 14px;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
    
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
    
                    Button {
                        text: root.workspace-tutorial-dismiss-label;
                        primary: true;
                        clicked => { root.workspace-tutorial-dismiss-clicked(); }
                    }
    
                    if root.workspace-tutorial-skip-all-label != "": Button {
                        text: root.workspace-tutorial-skip-all-label;
                        clicked => { root.workspace-tutorial-skip-all-clicked(); }
                    }
                }
            }
        }
    }
    
    if root.active-screen == 5: NoticeBoard {
        title <=> root.notice-board-title;
        empty-list-text <=> root.notice-board-empty-list-text;
        archive-button-text <=> root.notice-board-archive-button-text;
        date-today <=> root.notice-board-date-today;
        date-yesterday <=> root.notice-board-date-yesterday;
        importance-high-label <=> root.notice-board-importance-high-label;
        unread-marker <=> root.notice-board-unread-marker;
        diagnostic-action-label <=> root.notice-board-diagnostic-action-label;
        notice-model <=> root.notice-board-model;
        
        archive-all-clicked => { /* 只读公告栏（ADR-0021）：归档为未来提案，暂无动作 */ }
        notice-clicked(notice-id) => { /* 只读 + 可复制（ADR-0021）：不提供点击跳转 */ }
        diagnostic-action-clicked(notice-id) => { root.notice-diagnostic-action-clicked(notice-id); }
    }
    
    if root.active-screen == 6: Trash {
        title <=> root.trash-page-title;
        empty-list-text <=> root.trash-page-empty-list-text;
        restore-button-text <=> root.trash-page-restore-button-text;
        purge-button-text <=> root.trash-page-purge-button-text;
        retention-notice-text <=> root.trash-page-retention-notice-text;
        campus-prefix <=> root.trash-page-campus-prefix;
        trash-model <=> root.trash-page-model;

        restore-clicked(plan-id) => { root.trash-restore-clicked(plan-id) }
        purge-clicked(plan-id) => { root.trash-purge-clicked(plan-id) }
        purge-all-clicked() => { root.trash-purge-all-clicked() }
        
    }

    // ── 顶部工具栏 (ADR-0027)───────────────────────────────
    // 校区上下文内的屏才显示（方案列表/工作区/公告栏/回收站）
    if root.active-screen == 2 || root.active-screen == 4 || root.active-screen == 5 || root.active-screen == 6: Rectangle {
        y: 0;
        height: 56px;
        width: parent.width;
        background: Theme.surface;
        border-color: Theme.separator;
        
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 8px;
            
            // 工作区标题区左侧的层级返回入口；它不属于右侧四项辅助工具栏。
            if root.active-screen == 4: Button {
                text: root.workspace-back-to-plan-list-label;
                clicked => { root.workspace-back-to-plan-list-clicked(); }
            }

            Text {
                text: root.toolbar-title;
                font-size: 16px;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            
            Rectangle { 
                // 弹性间隔
            }
            
            // 公告栏图标 + 文字标签 + 未读角标 (ADR-0021/0027)
            if root.notice-toolbar-button-visible: HorizontalLayout {
                spacing: 4px;
                preferred-width: 64px;
                alignment: center;
                
                Rectangle {
                    preferred-width: 36px;
                    preferred-height: 32px;
                    
                    Button {
                        text: "📢";
                        width: 100%;
                        height: 100%;
                        clicked => { root.notice-toolbar-button-clicked(); }
                    }
                    
                    if root.notice-unread-count > 0: Rectangle {
                        x: parent.width - 16px;
                        y: -6px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: Theme.error;
                        
                        Text {
                            text: root.notice-unread-count;
                            color: Theme.text-inverse;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                
                Text {
                    text: root.notice-toolbar-label;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
            
            // 切换校区图标 + 文字标签
            if root.switch-campus-toolbar-button-visible: HorizontalLayout {
                spacing: 4px;
                preferred-width: 70px;
                alignment: center;
                
                Button {
                    text: "🔄";
                    clicked => { root.switch-campus-toolbar-button-clicked(); }
                }
                
                Text {
                    text: root.switch-campus-toolbar-label;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
            
            // 回收站图标 + 文字标签
            if root.trash-toolbar-button-visible: HorizontalLayout {
                spacing: 4px;
                preferred-width: 65px;
                alignment: center;
                
                Button {
                    text: "🗑️";
                    clicked => { root.trash-toolbar-button-clicked(); }
                }
                
                Text {
                    text: root.trash-toolbar-label;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
            
            // 设置图标 + 文字标签
            if root.settings-toolbar-button-visible: HorizontalLayout {
                spacing: 4px;
                preferred-width: 55px;
                alignment: center;
                
                Button {
                    text: "⚙️";
                    clicked => { root.settings-toolbar-button-clicked(); }
                }
                
                Text {
                    text: root.settings-toolbar-label;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }
    }

    // B7 普通提示 toast（ADR-0021：短暂弹出自动消失；warn 级分派触发）
    if root.toast-visible: Rectangle {
        x: (parent.width - 320px) / 2;
        y: parent.height - 96px;
        width: 320px;
        height: 64px;
        border-radius: 12px;
        background: Theme.surface;
        border-color: Theme.separator;
        border-width: 1px;
        
        VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 2px;
            
            Text {
                text: root.toast-title;
                font-size: 13px;
                font-weight: 700;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            
            Text {
                text: root.toast-body;
                font-size: 12px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
    
    Timer {
        interval: 4s;
        running: root.toast-visible;
        triggered => { root.toast-visible = false; }
    }

    ConfirmDialog {
        dialog-visible: root.confirm-dialog-visible;
        title: root.confirm-dialog-title;
        body: root.confirm-dialog-body;
        confirm-label: root.confirm-dialog-confirm-label;
        cancel-label: root.confirm-dialog-cancel-label;
        confirmed => { root.confirm-dialog-confirmed() }
        cancelled => { root.confirm-dialog-cancelled() }
    }

    // ── 通用输入窗（T19B-5A 对话框基建）──────────────────────
    InputDialog {
        dialog-visible: root.input-dialog-visible;
        title: root.input-dialog-title;
        label: root.input-dialog-label;
        input-text <=> root.input-dialog-text;
        confirm-label: root.input-dialog-confirm-label;
        cancel-label: root.input-dialog-cancel-label;
        confirmed => { root.input-dialog-confirmed() }
        cancelled => { root.input-dialog-cancelled() }
    }

    // B7 错误模态遮罩：盖住全窗吞掉全部输入，点"知道了"前界面不可操作
    // （弹窗铁律 ADR-0021"点掉才能继续"；声明在最后 = 渲染在最顶层）
    if root.error-dialog-visible: Rectangle {
        background: Theme.overlay;

        // 空 TouchArea 拦截遮罩区域的所有点击/滚动
        TouchArea { }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 64px, 440px);
            height: dialog-content.preferred-height + 48px;
            background: Theme.surface;
            border-radius: 8px;

            dialog-content := VerticalLayout {
                x: 24px;
                y: 24px;
                width: parent.width - 48px;
                spacing: 12px;

                Text {
                    text: root.error-dialog-title;
                    font-size: 18px;
                    color: Theme.error;
                    wrap: word-wrap;
                }

                Text {
                    text: root.error-dialog-source;
                    font-size: 12px;
                    color: Theme.text-secondary;
                }

                Text {
                    text: root.error-dialog-body;
                    font-size: 14px;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    if root.error-dialog-diagnostic-action-visible: Button {
                        text: root.error-dialog-diagnostic-action-label;
                        clicked => {
                            root.error-dialog-diagnostic-action-clicked(root.error-dialog-notification-id);
                        }
                    }

                    if root.error-dialog-retry-visible: Button {
                        text: root.error-dialog-retry-label;
                        clicked => {
                            root.error-dialog-retry-clicked();
                        }
                    }

                    Button {
                        text: root.error-dialog-ok-label;
                        primary: true;
                        clicked => {
                            root.error-dialog-dismissed();
                        }
                    }
                }
            }
        }
    }

}

