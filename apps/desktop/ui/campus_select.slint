// T19B-3 — 校区选择页。
// T19B-5A — 色卡角色名替换（ADR-0023），零硬编码颜色号。
//
// T19B-5 第 0 号前置：删除伪 ID 示例按钮，改为动态列表 + "新建演示校区"

import { Button, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

/// 校区视图数据（由 Rust 侧 F3 list_campuses 产出）
export struct CampusData {
    /// 校区 ID (UUID 文本)
    id: string,
    /// 校区名
    name: string,
}

export component CampusSelect inherits Rectangle {
    // ── 文案属性（全部由 Rust 侧 l10n 注入）────────────
    in property <string> title;
    in property <string> empty_list_text;  // T19B-5 新增：空列表占位
    // 按钮文案
    in property <string> new_demo_campus_button_text;
    in property <string> settings_button_text;

    // ── 数据模型 ──────────────────────────────────────
    in property <[CampusData]> campus-model;

    callback new-demo-campus-clicked();
    callback settings-clicked();
    
    width: 800px;
    height: 600px;
    
    VerticalLayout {
        spacing: 16px;
        padding: 24px;
        
        Text {
            text: root.title;
            font-size: 24px;
            horizontal-alignment: center;
        }
        
        if root.campus-model.length == 0: VerticalLayout {
            alignment: center;

            Text {
                text: root.empty_list_text;
                font-size: 15px;
                color: Theme.text-quaternary;
                horizontal-alignment: center;
            }
        }

        if root.campus-model.length > 0: ListView {
            for campus in root.campus-model: Rectangle {
                height: 56px;
                
                HorizontalLayout {
                    spacing: 8px;
                    padding: 12px;

                    Text {
                        text: campus.name;
                        font-size: 16px;
                    }
                }
                
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.separator;
                }
            }
        }
        
        // 底部操作区
        HorizontalLayout {
            alignment: end;
            spacing: 12px;
            
            Button {
                text: root.new_demo_campus_button_text;
                primary: true;
                clicked => { root.new-demo-campus-clicked(); }
            }
            
            Button {
                text: root.settings_button_text;
                clicked => { root.settings-clicked(); }
            }
        }
    }
}
