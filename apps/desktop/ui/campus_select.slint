// T19B-3 — 校区选择页（ADR-0006：搜索框 + 最近使用的校区）。
// T19B-5A — 色卡角色名替换（ADR-0023），零硬编码颜色号。
// S1-04 — 搜索只在点击"搜索"或按回车时触发；无记录时直接显示搜索框。
// UI 修复：内容列最大宽度 520 逻辑像素并居中，搜索行不再全宽拉伸；
// 800×666 / 1000×666 两档窗口下不截断、不溢出。

import { Button, LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

/// 校区视图数据（名称 + 地址，ADR-0006 最近记录卡片）
export struct CampusData {
    /// 校区 ID (UUID 文本)
    id: string,
    /// 校区名
    name: string,
    /// 校区地址（无地址时为空串）
    address: string,
}

export component CampusSelect inherits Rectangle {
    // ── 文案属性（全部由 Rust 侧 l10n 注入）────────────
    in property <string> title;
    in property <string> empty_list_text;
    in property <string> settings_button_text;
    // 搜索与最近记录（S1-04，ADR-0006）
    in-out property <string> search-text;
    in property <string> search-placeholder;
    in property <string> search-button-text;
    in property <string> recent-title;
    // 搜索结果区状态文案（如"正在搜索学校…"）
    in property <string> search-status;

    // ── 数据模型 ──────────────────────────────────────
    // campus-model = 最近使用的校区；result-model = 搜索结果
    in property <[CampusData]> campus-model;
    in property <[CampusData]> result-model;
    // true = 展示搜索结果，false = 展示最近使用记录
    in property <bool> show-results;

    callback settings-clicked();
    // 单击校区行 → 进入该校区方案列表
    callback campus-clicked(campus-id: string);
    // 最近记录右侧小叉 → 立即移除，不弹确认（ADR-0006）
    callback remove-recent-clicked(campus-id: string);
    // 点击"搜索"按钮或按回车触发；输入期间不自动搜索
    callback search-requested();

    // 内容列：宽度 = min(父宽 - 左右内边距, 520px)，水平居中；
    // 页面整体（搜索/最近使用/搜索结果）随之收敛，视觉平衡。
    HorizontalLayout {
        padding: 24px;
        alignment: center;

        content-column := VerticalLayout {
            width: min(parent.width - 48px, 520px);
            spacing: 16px;
            // 主轴默认 stretch：搜索行显式 36px 固定高度，不再被纵向拉高；
            // 列表/空态用 vertical-stretch 吸收其余空间。

            // 标题由统一工具栏显示（左侧返回 + 上下文标题），本页不再重复。

            // 搜索行：输入 + 按钮（搜索只在显式触发时开始）
            search-row := HorizontalLayout {
                spacing: 12px;
                height: 36px;

                search-input := LineEdit {
                    text <=> root.search-text;
                    placeholder-text: root.search-placeholder;
                    accepted => { root.search-requested(); }
                }

                Button {
                    text: root.search-button-text;
                    primary: true;
                    clicked => { root.search-requested(); }
                }
            }

            // 搜索结果（与最近使用记录按已确认规则切换）
            if root.show-results: ListView {
                vertical-stretch: 1;
                for campus in root.result-model: Rectangle {
                    height: 56px;

                    TouchArea {
                        clicked => { root.campus-clicked(campus.id); }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        padding: 12px;

                        VerticalLayout {
                            spacing: 2px;

                            Text {
                                text: campus.name;
                                font-size: 16px;
                            }

                            Text {
                                text: campus.address;
                                font-size: 12px;
                                color: Theme.text-tertiary;
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.separator;
                    }
                }
            }

            // 搜索结果区状态（搜索中/无结果提示；非空时显示在列表上方）
            if root.show-results && root.search-status != "": Text {
                text: root.search-status;
                font-size: 13px;
                color: Theme.text-secondary;
            }

            // 最近使用的校区（无搜索结果时展示；无记录时只显示搜索框与提示）
            if !root.show-results && root.campus-model.length > 0: VerticalLayout {
                spacing: 8px;
                vertical-stretch: 1;

                Text {
                    text: root.recent-title;
                    font-size: 15px;
                    color: Theme.text-secondary;
                }

                ListView {
                    vertical-stretch: 1;
                    for campus in root.campus-model: Rectangle {
                        height: 56px;

                        // 校区行单击热区（置于底层，右侧小叉优先捕获自身点击）
                        TouchArea {
                            clicked => { root.campus-clicked(campus.id); }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            padding: 12px;

                            VerticalLayout {
                                spacing: 2px;

                                Text {
                                    text: campus.name;
                                    font-size: 16px;
                                }

                                Text {
                                    text: campus.address;
                                    font-size: 12px;
                                    color: Theme.text-tertiary;
                                }
                            }

                            Rectangle {
                                // 弹性间隔
                            }

                            Button {
                                text: "×";
                                width: 28px;
                                height: 28px;
                                clicked => { root.remove-recent-clicked(campus.id); }
                            }
                        }

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.separator;
                        }
                    }
                }
            }

            if !root.show-results && root.campus-model.length == 0: VerticalLayout {
                alignment: center;
                vertical-stretch: 1;

                Text {
                    text: root.empty_list_text;
                    font-size: 15px;
                    color: Theme.text-quaternary;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
