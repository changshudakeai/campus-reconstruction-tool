// T19B-4 — 方案列表页（Screen 2）。
// T19B-5A — 色卡角色名替换（ADR-0023）+ ···菜单（ADR-0018 §三）。
//
// 薄壳原则（ADR-0017）：零业务逻辑，全部文案由 Rust 侧经 B6 l10n 注入。
// 卡片三件套（ADR-0018）：方案名 / 进度描述 / 最后修改时间（相对表述）。
// ···菜单操作（改名/复制/删除）由回调递 Rust 侧执行。
// 颜色一律引用 Theme 角色名（ADR-0023），零硬编码颜色号。

import { Button, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

/// 方案卡片视图数据（由 Rust 侧 F3 list_plan_cards 产出）
export struct PlanCardData {
    /// 方案 ID
    plan-id: string,
    /// 方案名
    name: string,
    /// 进度描述（B6 解析后的成品文案）
    progress-desc: string,
    /// 最后修改时间（相对表述成品文案，ADR-0018 §一第 3 条）
    last-modified: string,
}

export component PlanList inherits Rectangle {
    // ── 文案属性（全部由 Rust 侧 l10n 注入）──────────────────
    in property <string> title;
    in property <string> campus-name;
    in property <string> create-button-text;
    in property <string> back-button-text;
    in property <string> empty-list-text;
    // ···菜单项文案（ADR-0018 §三）
    in property <string> rename-label;
    in property <string> duplicate-label;
    in property <string> delete-label;
    // 教程气泡（F2：跟练引导气泡，ADR-0020/0028）
    in property <bool> tutorial-bubble-visible;
    in property <string> tutorial-bubble-text;
    in property <string> tutorial-dismiss-label;
    in property <string> tutorial-skip-all-label;

    // ── 数据模型 ──────────────────────────────────────────────
    in property <[PlanCardData]> plan-model;

    // ── 回调（Rust 侧绑定业务逻辑）──────────────────────────
    callback create-plan-clicked();
    callback back-to-campus-clicked();
    // 卡片单击打开方案工作区（ADR-0027 第 6 轮：单击即开，无概览层）
    callback card-clicked(plan-id: string);
    callback rename-plan-clicked(plan-id: string);
    callback duplicate-plan-clicked(plan-id: string);
    callback delete-plan-clicked(plan-id: string);
    callback tutorial-dismiss-clicked();
    callback tutorial-skip-all-clicked();

    width: 800px;
    height: 600px;

    VerticalLayout {
        spacing: 12px;
        padding: 24px;

        // 顶部：操作行（标题由统一工具栏显示；本页保留“新建方案”）
        create-action-row := HorizontalLayout {
            height: 36px;
            spacing: 12px;

            Rectangle {
                // 弹性间隔
            }

            create-plan-button := Button {
                height: 32px;
                text: root.create-button-text;
                primary: true;
                clicked => { root.create-plan-clicked(); }
            }
        }

        Text {
            text: root.campus-name;
            font-size: 13px;
            color: Theme.text-secondary;
        }

        // 卡片列表区域
        if root.plan-model.length == 0: VerticalLayout {
            alignment: center;

            Text {
                text: root.empty-list-text;
                font-size: 15px;
                color: Theme.text-quaternary;
                horizontal-alignment: center;
            }
        }

        if root.plan-model.length > 0: ListView {
            for card in root.plan-model: Rectangle {
                height: 72px;

                // 卡片单击热区（置于底层，···菜单按钮优先捕获自身点击）
                TouchArea {
                    clicked => { root.card-clicked(card.plan-id); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    padding-left: 12px;
                    padding-right: 12px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;

                        Text {
                            text: card.name;
                            font-size: 16px;
                            color: Theme.text-primary;
                        }

                        Text {
                            text: card.progress-desc;
                            font-size: 12px;
                            color: Theme.text-tertiary;
                        }
                    }

                    Rectangle { width: 8px; }

                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: card.last-modified;
                            font-size: 12px;
                            color: Theme.text-faint;
                            horizontal-alignment: right;
                        }
                    }

                    // ···菜单按钮（ADR-0018 §三：一个按钮，点开浮层菜单）
                    VerticalLayout {
                        alignment: center;
                        width: 40px;

                        Button {
                            text: "···";
                            width: 36px;
                            height: 28px;
                            clicked => { card-menu.show(); }
                        }
                    }
                }

                // ···浮层菜单（ADR-0018 §三：改名/复制/删除）
                card-menu := PopupWindow {
                    width: 120px;
                    height: menu-layout.preferred-height + 8px;

                    Rectangle {
                        background: Theme.surface;
                        border-radius: 4px;

                        menu-layout := VerticalLayout {
                            padding: 4px;
                            spacing: 2px;

                            Button {
                                text: root.rename-label;
                                clicked => { card-menu.close(); root.rename-plan-clicked(card.plan-id); }
                            }

                            Button {
                                text: root.duplicate-label;
                                clicked => { card-menu.close(); root.duplicate-plan-clicked(card.plan-id); }
                            }

                            Button {
                                text: root.delete-label;
                                clicked => { card-menu.close(); root.delete-plan-clicked(card.plan-id); }
                            }
                        }
                    }
                }

                // 卡片分隔线
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.separator;
                }
            }
        }

    }

    // 教程气泡浮层（F2：跟练引导气泡，ADR-0020/0028）
    if root.tutorial-bubble-visible: Rectangle {
        x: 16px;
        y: 80px;
        width: 300px;
        height: bubble-layout.preferred-height + 24px;
        background: Theme.bubble-background;
        border-radius: 8px;
        border-color: Theme.bubble-border;
        border-width: 1px;

        bubble-layout := VerticalLayout {
            padding: 12px;
            spacing: 8px;

            Text {
                text: root.tutorial-bubble-text;
                font-size: 14px;
                color: Theme.text-primary;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Button {
                    text: root.tutorial-dismiss-label;
                    primary: true;
                    clicked => { root.tutorial-dismiss-clicked(); }
                }

                if root.tutorial-skip-all-label != "": Button {
                    text: root.tutorial-skip-all-label;
                    clicked => { root.tutorial-skip-all-clicked(); }
                }
            }
        }
    }
}
