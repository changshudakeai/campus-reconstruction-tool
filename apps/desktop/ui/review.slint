// F5 评审页（M3）+ T38 抽屉化：地图为主区 + 左侧评审抽屉。
// 仅呈现 F5 WorkbenchView 返回的页面状态并转发用户操作。
// 三态判定、批量确认、封账全部由 F5 评审工作台入口完成；
// 地图标注/定位/联动高亮由评审入口经 map_webview 桥接（本组件零业务逻辑）。
//
// T51：筛选芯片改为 全部/高/中/低 四档；候选卡片上方固定批量操作行
// （全选＝当前页 + 已选数量 + 批量三态，批量剔除始终确认）；分页行常显；
// 删除暂停/继续按钮（离开自动保存、返回自动恢复）；选中底色与地图联动高亮
// 解耦（选中=蓝底，地图高亮=描边）。
import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// 300px 抽屉专用类别入口：标准 Button 的平台内边距会挤压“植被 (1095)”等
// 完整文案，因此这里用现有 Theme 角色呈现可点击入口。文字不省略、不缩写。
component ReviewCategoryButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 34px;
    background: root.active ? Theme.highlight : Theme.surface;
    border-color: Theme.separator;
    border-width: root.active ? 2px : 1px;
    border-radius: 4px;

    Text {
        x: 2px;
        width: parent.width - 4px;
        height: parent.height;
        text: root.label;
        font-size: 11px;
        font-weight: root.active ? 700 : 400;
        color: Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

/// 批量行紧凑按钮：300px 抽屉内把“全选 + 已选数量 + 三个批量按钮”压进
/// 固定一行（T51），避免标准 Button 内边距把批量行挤出视口。
component ReviewBatchButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled;
    callback clicked();

    height: 24px;
    background: Theme.surface;
    border-color: Theme.separator;
    border-width: 1px;
    border-radius: 4px;
    opacity: root.enabled ? 1.0 : 0.45;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        font-size: 11px;
        color: Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.enabled;
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

/// T51 自绘复选框：std fluent CheckBox 的 `checked` 在用户点击后会由组件内部
/// 改写，外部属性绑定不再驱动勾选视觉；这里改用普通属性绑定驱动的自绘
/// 复选框，保证"全选/卡片勾选"视觉始终跟随状态。
component ReviewCardCheckbox inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled;
    callback toggled();

    width: 18px;
    height: 18px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.checked ? Theme.map-highlight : Theme.surface;
    border-color: root.checked ? Theme.map-highlight : Theme.text-secondary;
    border-width: 1px;
    border-radius: 2px;

    Text {
        text: root.checked ? "✓" : "";
        font-size: 13px;
        color: Theme.text-inverse;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.enabled;
        width: parent.width;
        height: parent.height;
        clicked => { root.toggled(); }
    }
}

/// 固定批量行里的"全选（只选当前页）"复选框：同上，自绘以跟随外部状态。
component ReviewSelectAllCheckbox inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> enabled;
    callback toggled();

    height: 24px;
    opacity: root.enabled ? 1.0 : 0.45;

    HorizontalLayout {
        spacing: 4px;
        Rectangle {
            width: 18px;
            height: 18px;
            background: root.checked ? Theme.map-highlight : Theme.surface;
            border-color: root.checked ? Theme.map-highlight : Theme.text-secondary;
            border-width: 1px;
            border-radius: 2px;
            Text {
                text: root.checked ? "✓" : "";
                font-size: 13px;
                color: Theme.text-inverse;
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.label;
            font-size: 11px;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: root.enabled;
        width: parent.width;
        height: parent.height;
        clicked => { root.toggled(); }
    }
}

/// 评审抽屉上一张候选卡片的完整呈现数据（由 Rust 侧经 B6 文本键注入）。
export struct ReviewCandidateData {
    /// 稳定候选 ID（三态判定、复选、定位与高亮操作回传）。
    candidate-id: string,
    /// 卡片标题（未命名候选由 Rust 侧拼成"未命名建筑 #id"）。
    title: string,
    /// 标题是否来自真实名称（false → 未命名，UI 显示"未命名建筑 #id"）。
    named: bool,
    /// 当前三态显示名。
    state-label: string,
    /// 当前三态标识（pending/keep/remove）。
    state-key: string,
    /// 复选状态（多选：选中卡片蓝底）。
    selected: bool,
    /// 与地图对象联动高亮（点击地图对象/卡片共用同一份高亮；独立描边样式）。
    highlighted: bool,
    /// 建议动作显示名（如"建议保留"；无建议时为空串）。
    suggestion-action-label: string,
    /// 一句话可读建议理由（无建议时为空串）。
    suggestion-reason: string,
}

/// 左侧评审抽屉：类别标签 + 置信度筛选 + 固定批量行 + 可滚动候选列表 +
/// 常显分页 + 一键应用建议 + 封账（T51 布局）。
export component ReviewDrawer inherits Rectangle {
    in property <string> title;
    in property <string> empty-text;
    in property <int> candidate-count;
    in property <[string]> category-labels;
    in property <[int]> category-counts;
    in property <int> active-category;
    in property <[ReviewCandidateData]> cards;
    // T39 分页（Slint 无虚拟化）：当前页切片 + 页码/翻页按钮（T51 常显，含 1/1）。
    in property <int> page-size;
    in property <int> page-index;
    in property <int> page-total;
    in property <string> page-label;
    in property <string> page-prev-label;
    in property <string> page-next-label;
    // 固定批量行：全选（只选当前页）+ 已选数量 + 批量三态。
    in property <string> selected-count-label;
    in property <bool> all-page-selected;
    in property <bool> batch-buttons-enabled;
    in property <string> set-keep-label;
    in property <string> set-reject-label;
    in property <string> set-pending-label;
    in property <string> select-all-label;
    in property <string> card-pending-label;
    in property <string> card-keep-label;
    in property <string> card-reject-label;
    in property <string> locate-label;
    in property <string> legend;
    in property <string> seal-label;
    in property <bool> sealed;
    // 置信度筛选：全部/高/中/低（单选，标签含计数）。
    in property <string> confidence-filters-label;
    in property <[string]> confidence-filter-labels;
    in property <[int]> confidence-filter-counts;
    in property <[int]> confidence-filter-active;
    // 三态分组：待定/保留/剔除（默认待定；评审后卡片离开当前分组）。
    in property <[string]> state-tab-labels;
    in property <[int]> state-tab-counts;
    in property <[int]> state-tab-active;
    // 一键应用建议 / 撤销上一批。
    in property <string> apply-suggestions-label;
    in property <string> undo-suggestions-label;
    in property <bool> apply-suggestions-enabled;
    in property <bool> undo-available;
    in property <bool> summary-visible;
    in property <string> summary-text;

    // T33 契约观测（仅布局观测，不参与评审/封账逻辑）：
    // list-viewport-y：候选列表滚动容器当前滚动位置（滚轮/键盘滚动后为负，
    // 分类切换复位到顶）；可点性由契约测试对"封账"按钮的真实点击断言。
    in-out property <length> list-viewport-y;

    callback category-clicked(index: int);
    callback page-prev-clicked();
    callback page-next-clicked();
    callback card-highlight-clicked(candidate-id: string);
    callback card-state-clicked(candidate-id: string, state: string);
    callback card-selection-toggled(candidate-id: string);
    callback locate-clicked(candidate-id: string);
    callback select-all-toggled();
    callback bulk-state-clicked(state: string);
    callback seal-clicked();
    callback confidence-filter-clicked(index: int);
    callback state-tab-clicked(index: int);
    callback apply-suggestions-clicked();
    callback undo-suggestions-clicked();

    background: Theme.surface;
    border-color: Theme.separator;
    border-width: 1px;
    border-radius: 8px;
    clip: true;

    VerticalLayout {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: parent.height - 24px;
        spacing: 6px;

        Text {
            text: root.title;
            font-size: 14px;
            font-weight: 700;
            color: Theme.text-primary;
        }

        // 无候选空态：明确提示可跳过，不阻塞导出、不伪造评审完成。
        if root.candidate-count == 0: Text {
            text: root.empty-text;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }

        if root.candidate-count > 0: VerticalLayout {
            vertical-stretch: 1;
            spacing: 6px;

            // 六类标签页（ADR-0016）：固定 3×2。300px 抽屉内每格等宽，
            // 完整显示两字类别名与四位数数量；切换时列表复位到顶。
            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 4px;
                    ReviewCategoryButton {
                        label: root.category-labels[0];
                        active: root.active-category == 0; horizontal-stretch: 1;
                        clicked => { review-cards-scroll.viewport-y = 0px; root.category-clicked(0); }
                    }
                    ReviewCategoryButton {
                        label: root.category-labels[1];
                        active: root.active-category == 1; horizontal-stretch: 1;
                        clicked => { review-cards-scroll.viewport-y = 0px; root.category-clicked(1); }
                    }
                    ReviewCategoryButton {
                        label: root.category-labels[2];
                        active: root.active-category == 2; horizontal-stretch: 1;
                        clicked => { review-cards-scroll.viewport-y = 0px; root.category-clicked(2); }
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    ReviewCategoryButton {
                        label: root.category-labels[3];
                        active: root.active-category == 3; horizontal-stretch: 1;
                        clicked => { review-cards-scroll.viewport-y = 0px; root.category-clicked(3); }
                    }
                    ReviewCategoryButton {
                        label: root.category-labels[4];
                        active: root.active-category == 4; horizontal-stretch: 1;
                        clicked => { review-cards-scroll.viewport-y = 0px; root.category-clicked(4); }
                    }
                    ReviewCategoryButton {
                        label: root.category-labels[5];
                        active: root.active-category == 5; horizontal-stretch: 1;
                        clicked => { review-cards-scroll.viewport-y = 0px; root.category-clicked(5); }
                    }
                }
            }

            // T51 置信度筛选：全部/高/中/低 四个芯片（单选，与六类标签组合）。
            HorizontalLayout {
                spacing: 2px;
                ReviewCategoryButton {
                    label: root.confidence-filter-labels[0];
                    active: root.confidence-filter-active[0] == 1;
                    horizontal-stretch: 1;
                    height: 22px;
                    clicked => { review-cards-scroll.viewport-y = 0px; root.confidence-filter-clicked(0); }
                }
                ReviewCategoryButton {
                    label: root.confidence-filter-labels[1];
                    active: root.confidence-filter-active[1] == 1;
                    horizontal-stretch: 1;
                    height: 22px;
                    clicked => { review-cards-scroll.viewport-y = 0px; root.confidence-filter-clicked(1); }
                }
                ReviewCategoryButton {
                    label: root.confidence-filter-labels[2];
                    active: root.confidence-filter-active[2] == 1;
                    horizontal-stretch: 1;
                    height: 22px;
                    clicked => { review-cards-scroll.viewport-y = 0px; root.confidence-filter-clicked(2); }
                }
                ReviewCategoryButton {
                    label: root.confidence-filter-labels[3];
                    active: root.confidence-filter-active[3] == 1;
                    horizontal-stretch: 1;
                    height: 22px;
                    clicked => { review-cards-scroll.viewport-y = 0px; root.confidence-filter-clicked(3); }
                }
            }

            // T51 后续优化：三态分组（默认“待定”）。在待定里完成评审后，
            // 卡片立即离开待定并进入保留/剔除分组。
            HorizontalLayout {
                spacing: 2px;
                ReviewCategoryButton {
                    label: root.state-tab-labels[0];
                    active: root.state-tab-active[0] == 1;
                    horizontal-stretch: 1;
                    height: 22px;
                    clicked => { review-cards-scroll.viewport-y = 0px; root.state-tab-clicked(0); }
                }
                ReviewCategoryButton {
                    label: root.state-tab-labels[1];
                    active: root.state-tab-active[1] == 1;
                    horizontal-stretch: 1;
                    height: 22px;
                    clicked => { review-cards-scroll.viewport-y = 0px; root.state-tab-clicked(1); }
                }
                ReviewCategoryButton {
                    label: root.state-tab-labels[2];
                    active: root.state-tab-active[2] == 1;
                    horizontal-stretch: 1;
                    height: 22px;
                    clicked => { review-cards-scroll.viewport-y = 0px; root.state-tab-clicked(2); }
                }
            }

            // 三态与选中态图例：与地图标注保持一致（待定虚线/保留实线/红色选中）。
            Text {
                text: root.legend;
                font-size: 11px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            // T51 固定批量行（在候选卡片上方，不随滚动消失）：
            // 全选复选框（只选当前页）+ 已选数量 + 改为保留/剔除/待定。
            HorizontalLayout {
                spacing: 4px;
                ReviewSelectAllCheckbox {
                    label: root.select-all-label;
                    checked: root.all-page-selected;
                    enabled: !root.sealed;
                    toggled => { root.select-all-toggled(); }
                }
                Text {
                    text: root.selected-count-label;
                    font-size: 11px;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                ReviewBatchButton {
                    label: root.set-keep-label;
                    enabled: root.batch-buttons-enabled && !root.sealed;
                    horizontal-stretch: 1;
                    clicked => { root.bulk-state-clicked("keep"); }
                }
                ReviewBatchButton {
                    label: root.set-reject-label;
                    enabled: root.batch-buttons-enabled && !root.sealed;
                    horizontal-stretch: 1;
                    clicked => { root.bulk-state-clicked("remove"); }
                }
                ReviewBatchButton {
                    label: root.set-pending-label;
                    enabled: root.batch-buttons-enabled && !root.sealed;
                    horizontal-stretch: 1;
                    clicked => { root.bulk-state-clicked("pending"); }
                }
            }

            // 候选卡片：可滚动（滚轮由 ScrollView 原生处理；键盘经 FocusScope
            // 转发为滚动）；点击卡片高亮（地图↔卡片双向联动）；三态点错可直接改。
            review-focus := FocusScope {
                focus-on-click: true;
                vertical-stretch: 1;
                key-pressed(event) => {
                    if (event.text == Key.UpArrow) {
                        review-cards-scroll.viewport-y = Math.min(0px, review-cards-scroll.viewport-y + 36px);
                        return accept;
                    } else if (event.text == Key.DownArrow) {
                        review-cards-scroll.viewport-y = Math.max(review-cards-scroll.visible-height - review-cards-scroll.viewport-height, review-cards-scroll.viewport-y - 36px);
                        return accept;
                    } else if (event.text == Key.PageUp) {
                        review-cards-scroll.viewport-y = Math.min(0px, review-cards-scroll.viewport-y + review-cards-scroll.visible-height);
                        return accept;
                    } else if (event.text == Key.PageDown) {
                        review-cards-scroll.viewport-y = Math.max(review-cards-scroll.visible-height - review-cards-scroll.viewport-height, review-cards-scroll.viewport-y - review-cards-scroll.visible-height);
                        return accept;
                    } else if (event.text == Key.Home) {
                        review-cards-scroll.viewport-y = 0px;
                        return accept;
                    } else if (event.text == Key.End) {
                        review-cards-scroll.viewport-y = review-cards-scroll.visible-height - review-cards-scroll.viewport-height;
                        return accept;
                    }
                    reject
                }
                review-cards-scroll := ScrollView {
                    viewport-y <=> root.list-viewport-y;
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        spacing: 8px;
                        for card in root.cards:
                            Rectangle {
                                // T51 缺陷修复：选中底色跟随多选状态；地图联动高亮
                                // 保留独立描边样式，两者解耦。
                                background: card.selected ? Theme.highlight : transparent;
                                border-color: card.highlighted ? Theme.map-highlight : transparent;
                                border-width: card.highlighted ? 2px : 1px;
                                border-radius: 6px;
                                TouchArea {
                                    clicked => {
                                        review-focus.focus();
                                        root.card-highlight-clicked(card.candidate-id);
                                    }
                                }
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        ReviewCardCheckbox {
                                            checked: card.selected;
                                            enabled: !root.sealed;
                                            toggled => { root.card-selection-toggled(card.candidate-id); }
                                        }
                                        Text {
                                            text: card.title;
                                            color: Theme.text-primary;
                                            horizontal-stretch: 1;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: card.state-label;
                                            color: Theme.text-secondary;
                                        }
                                    }
                                    if card.suggestion-reason != "": HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: card.suggestion-action-label;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: Theme.highlight;
                                        }
                                    }
                                    if card.suggestion-reason != "": Text {
                                        text: card.suggestion-reason;
                                        font-size: 11px;
                                        color: Theme.text-secondary;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button {
                                            text: root.card-pending-label;
                                            enabled: !root.sealed;
                                            clicked => { root.card-state-clicked(card.candidate-id, "pending"); }
                                        }
                                        Button {
                                            text: root.card-keep-label;
                                            enabled: !root.sealed;
                                            clicked => { root.card-state-clicked(card.candidate-id, "keep"); }
                                        }
                                        Button {
                                            text: root.card-reject-label;
                                            enabled: !root.sealed;
                                            clicked => { root.card-state-clicked(card.candidate-id, "remove"); }
                                        }
                                    }
                                    Button {
                                        text: root.locate-label;
                                        enabled: !root.sealed;
                                        clicked => { root.locate-clicked(card.candidate-id); }
                                    }
                                }
                            }
                    }
                }
            }

            // T51 分页行常显（含 1/1）：筛选后分页保持可用，不再因只剩一页消失。
            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: root.page-prev-label;
                    enabled: root.page-index > 0;
                    clicked => { root.page-prev-clicked(); }
                }
                Text {
                    text: root.page-label;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Button {
                    text: root.page-next-label;
                    enabled: root.page-index < root.page-total - 1;
                    clicked => { root.page-next-clicked(); }
                }
            }

            // T51 一键应用建议：只把高置信转为保留并先弹确认；主操作，用主题色
            // 标注防止错过。撤销上一批保留为次要按钮。
            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: root.apply-suggestions-label;
                    primary: true;
                    enabled: root.apply-suggestions-enabled && !root.sealed;
                    clicked => { root.apply-suggestions-clicked(); }
                }
                Button {
                    text: root.undo-suggestions-label;
                    enabled: root.undo-available && !root.sealed;
                    clicked => { root.undo-suggestions-clicked(); }
                }
            }

            // 封账（固定于抽屉底部，T33 大量候选下可达；T51 删除暂停/继续按钮）。
            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: root.seal-label;
                    primary: true;
                    enabled: !root.sealed;
                    clicked => { root.seal-clicked(); }
                }
            }

            // 封账成功后的导出摘要。
            if root.summary-visible: Text {
                text: root.summary-text;
                color: Theme.text-primary;
                wrap: word-wrap;
            }
        }
    }
}
