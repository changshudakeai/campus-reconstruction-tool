// T34: 左侧操作抽屉（做法 A：地图让位）。
//
// 薄壳原则 (ADR-0017): 零业务逻辑，只把抽屉按钮点击转发给工作区功能入口。
// 颜色一律引用 Theme 角色名 (ADR-0023)，零硬编码颜色号。
// 文案全部由 Rust 侧经 B6 l10n 注入 (ADR-0005)，.slint 零硬编码中文。
//
// 抽屉内容按步骤：
//   ① 圈边界：当前点数 / 撤销 / 清空 / 确认边界
//   ② 定朝向：自动角度 + 小罗盘预览 / 手动输角度 / 确认两点朝向 / 重置
//   ③ 采集：来源 / 开始 / 进度 / 差异摘要 / 查看报告
//   ⑤ 导出：开始导出 / 结果 / 错误状态

import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { OrientationIndicator } from "orientation.slint";

/// 左侧操作抽屉：按当前步骤显示对应操作。
export component WorkspaceDrawer inherits Rectangle {
    in property <int> active-step;

    // ── ① 圈边界 ──────────────────────────────
    in property <int> boundary-point-count;
    in property <string> boundary-points-label;
    in property <string> boundary-status;
    in property <string> boundary-fetch-status;
    in property <bool> boundary-is-determined;
    in property <string> boundary-undo-label;
    in property <string> boundary-reset-label;
    in property <string> boundary-refresh-label;
    in property <string> boundary-delete-selected-label;
    in property <bool> boundary-delete-selected-enabled;
    // 已确认边界被再次编辑后为 true：确认按钮重新可用，可把调整后的
    // 顶点重新确认并覆盖落库。
    in property <bool> boundary-edited-since-confirmed;
    in property <string> boundary-confirm-label;
    callback boundary-undo-clicked();
    callback boundary-delete-selected-clicked();
    callback boundary-reset-clicked();
    callback boundary-refresh-clicked();
    callback boundary-confirm-clicked();

    // ── ② 定朝向 ──────────────────────────────
    in property <float> orientation-angle: -1.0;
    in property <string> orientation-angle-display;
    in property <string> orientation-current-angle-label;
    in property <string> orientation-arrow-commands;
    in property <bool> orientation-is-determined;
    in property <string> orientation-status;
    in-out property <string> orientation-input-text;
    in property <string> orientation-angle-input-placeholder;
    in property <string> orientation-submit-label;
    in property <string> orientation-confirm-two-points-label;
    in property <string> orientation-reset-label;
    callback orientation-submit-clicked();
    callback orientation-confirm-two-points-clicked();
    callback orientation-reset-clicked();

    // ── ③ 采集 ──────────────────────────────
    in property <string> collection-source-label;
    in property <string> collection-collect-label;
    in property <string> collection-progress-label;
    in property <[string]> collection-category-labels;
    in property <[string]> collection-category-statuses;
    in property <string> collection-category-skip-label;
    in property <string> collection-diff-summary;
    in property <string> collection-report-entry-label;
    in property <string> collection-report-body;
    in property <string> collection-stage-label;
    in property <string> collection-elapsed-label;
    in property <string> collection-cancel-label;
    in property <bool> collection-cancel-visible;
    in property <string> collection-partial-naming-label;
    callback collection-start-clicked();
    callback collection-report-clicked();
    callback collection-cancel-clicked();

    // ── ⑤ 导出 ──────────────────────────────
    in property <string> export-start-label;
    in property <string> export-status-title;
    in property <string> export-status-body;
    in property <bool> export-can-start;
    // T52：第五步 3D 方块预览（呈现层，不含业务逻辑）
    in property <string> export-preview-generate-label;
    in property <string> export-preview-status;
    in property <string> export-preview-reset-label;
    in property <string> export-preview-zoom-in-label;
    in property <string> export-preview-zoom-out-label;
    in property <string> export-preview-controls-hint;
    in property <bool> export-preview-has-content;
    in property <bool> export-preview-generating;
    callback export-start-clicked();
    callback export-preview-generate-clicked();
    callback export-preview-reset-clicked();
    callback export-preview-zoom-in-clicked();
    callback export-preview-zoom-out-clicked();

    background: Theme.surface;
    border-color: Theme.separator;
    border-width: 1px;
    border-radius: 8px;
    clip: true;

    ScrollView {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: parent.height - 24px;
        VerticalLayout {
            spacing: 10px;
            alignment: start;

            // ① 圈边界
            if root.active-step == 0: VerticalLayout {
                spacing: 10px;
                Text {
                    text: root.boundary-points-label;
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
                Text {
                    text: root.boundary-status;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                if root.boundary-fetch-status != "": Text {
                    text: root.boundary-fetch-status;
                    font-size: 12px;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
                Button {
                    text: root.boundary-undo-label;
                    enabled: !root.boundary-is-determined && root.boundary-point-count > 0;
                    clicked => { root.boundary-undo-clicked(); }
                }
                Button {
                    text: root.boundary-reset-label;
                    enabled: root.boundary-point-count > 0;
                    clicked => { root.boundary-reset-clicked(); }
                }
                Button {
                    text: root.boundary-refresh-label;
                    clicked => { root.boundary-refresh-clicked(); }
                }
                Button {
                    text: root.boundary-delete-selected-label;
                    enabled: root.boundary-delete-selected-enabled;
                    clicked => { root.boundary-delete-selected-clicked(); }
                }
                Button {
                    text: root.boundary-confirm-label;
                    primary: true;
                    enabled: root.boundary-point-count >= 3
                        && (!root.boundary-is-determined || root.boundary-edited-since-confirmed);
                    clicked => { root.boundary-confirm-clicked(); }
                }
            }

            // ② 定朝向
            if root.active-step == 1: VerticalLayout {
                spacing: 10px;
                Text {
                    text: root.orientation-current-angle-label + " " + root.orientation-angle-display;
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
                OrientationIndicator {
                    angle: root.orientation-angle;
                    angle-display: root.orientation-angle-display;
                    arrow-commands: root.orientation-arrow-commands;
                    indicator-size: 72px;
                }
                Text {
                    text: root.orientation-status;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                LineEdit {
                    text <=> root.orientation-input-text;
                    placeholder-text: root.orientation-angle-input-placeholder;
                    // T37：角度输入框只接受数字（可小数，按当前 locale 的小数分隔符）
                    input-type: InputType.decimal;
                }
                Button {
                    text: root.orientation-submit-label;
                    primary: true;
                    enabled: root.orientation-input-text != "";
                    clicked => { root.orientation-submit-clicked(); }
                }
                Button {
                    text: root.orientation-confirm-two-points-label;
                    enabled: root.orientation-angle >= 0.0;
                    clicked => { root.orientation-confirm-two-points-clicked(); }
                }
                Button {
                    text: root.orientation-reset-label;
                    enabled: root.orientation-angle >= 0.0 || root.orientation-is-determined;
                    clicked => { root.orientation-reset-clicked(); }
                }
            }

            // ③ 采集
            if root.active-step == 2: VerticalLayout {
                spacing: 10px;
                Text {
                    text: root.collection-source-label;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Text {
                    text: root.collection-progress-label;
                    font-size: 14px;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
                // T36：处理中阶段 + 已用时长 + 取消采集
                Text {
                    text: root.collection-stage-label + (root.collection-elapsed-label != "" ? "  ·  " + root.collection-elapsed-label : "");
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Text {
                    text: root.collection-partial-naming-label;
                    font-size: 12px;
                    color: Theme.error;
                    wrap: word-wrap;
                }
                Button {
                    text: root.collection-cancel-label;
                    visible: root.collection-cancel-visible;
                    clicked => { root.collection-cancel-clicked(); }
                }
                for label[i] in root.collection-category-labels: HorizontalLayout {
                    Text {
                        text: label;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: root.collection-category-statuses[i] + " · " + root.collection-category-skip-label;
                        color: Theme.text-secondary;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                    }
                }
                Text {
                    text: root.collection-diff-summary;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Button {
                    text: root.collection-collect-label;
                    primary: true;
                    clicked => { root.collection-start-clicked(); }
                }
                Button {
                    text: root.collection-report-entry-label;
                    clicked => { root.collection-report-clicked(); }
                }
                Text {
                    text: root.collection-report-body;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }

            // ⑤ 导出
            if root.active-step == 4: VerticalLayout {
                spacing: 10px;
                Text {
                    text: root.export-status-title;
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
                Text {
                    text: root.export-status-body;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                // T52：3D 预览区块。生成按钮显眼置顶；预览失败只提示、不阻塞导出。
                Button {
                    text: root.export-preview-generate-label;
                    primary: true;
                    enabled: !root.export-preview-generating;
                    clicked => { root.export-preview-generate-clicked(); }
                }
                if root.export-preview-status != "": Text {
                    text: root.export-preview-status;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                if root.export-preview-has-content: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: root.export-preview-controls-hint;
                        font-size: 12px;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: root.export-preview-reset-label;
                            enabled: !root.export-preview-generating;
                            clicked => { root.export-preview-reset-clicked(); }
                        }
                        Button {
                            text: root.export-preview-zoom-in-label;
                            enabled: !root.export-preview-generating;
                            clicked => { root.export-preview-zoom-in-clicked(); }
                        }
                        Button {
                            text: root.export-preview-zoom-out-label;
                            enabled: !root.export-preview-generating;
                            clicked => { root.export-preview-zoom-out-clicked(); }
                        }
                    }
                }
                Button {
                    text: root.export-start-label;
                    primary: true;
                    enabled: root.export-can-start;
                    clicked => { root.export-start-clicked(); }
                }
            }
        }
    }
}
