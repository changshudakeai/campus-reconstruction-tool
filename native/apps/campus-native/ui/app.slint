import { AboutSlint, Button, ComboBox, LineEdit, ScrollView, Slider } from "std-widgets.slint";

export struct CandidateRow {
    id: string,
    name: string,
    meta: string,
    status: string,
    pending: bool,
}

export struct LauncherProjectRow {
    project-id: string,
    project-name: string,
    latest-save: string,
    save-state: string,
    progress: string,
    next-task: string,
    action-label: string,
}

component SectionLabel inherits Text {
    color: #a54836;
    font-size: 12px;
    font-weight: 700;
}

component Rule inherits Rectangle {
    height: 1px;
    background: #b7ad9a;
}

component CandidateItem inherits Rectangle {
    in property <CandidateRow> candidate;
    in property <bool> english;
    callback decide(string, bool);
    callback reset(string);
    callback inspect(string);
    height: 72px;
    background: #f7f3e9;
    border-color: #c7bca8;
    border-width: 1px;
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        VerticalLayout {
            spacing: 3px;
            Text { text: candidate.name; font-weight: 700; color: #17251f; }
            Text { text: candidate.meta; font-size: 12px; color: #617068; }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        Text { text: candidate.status; color: #a54836; vertical-alignment: center; }
        Button { text: root.english ? "Details" : "详情"; clicked => { root.inspect(candidate.id); } }
        Button { text: root.english ? "Revoke" : "撤销"; enabled: !candidate.pending; clicked => { root.reset(candidate.id); } }
        Button { text: root.english ? "Reject" : "拒绝"; enabled: candidate.pending; clicked => { root.decide(candidate.id, false); } }
        Button { text: root.english ? "Accept" : "接受"; enabled: candidate.pending; clicked => { root.decide(candidate.id, true); } }
    }
}

export component AppWindow inherits Window {
    title: "Minecraft 校园复刻工具";
    width: 1280px;
    height: 720px;
    background: #f4f0e5;
    default-font-family: "Microsoft YaHei UI";
    forward-focus: shortcut-scope;

    in-out property <string> project-name: "未命名项目";
    in-out property <string> campus-name: "华东师范大学普陀校区";
    in-out property <bool> has-campus-target: false;
    in-out property <string> save-status: "未保存";
    in-out property <string> tool-status: "";
    in-out property <bool> error-visible: false;
    in-out property <string> error-summary: "";
    in-out property <string> error-details: "";
    in-out property <string> page-title: "选择学校与具体校区";
    in-out property <string> page-help: "确认校区后再发现建筑、道路、水域、植被与体育设施。";
    in-out property <string> project-summary: "尚未建立项目";
    in-out property <bool> campus-launcher-visible: false;
    in-out property <int> launcher-step: 0;
    in-out property <int> route-stage: 0;
    in-out property <string> launcher-campus-name: "";
    in-out property <string> launcher-new-project-name: "";
    in-out property <string> launcher-active-project-id: "";
    in-out property <[LauncherProjectRow]> launcher-projects: [];
    in-out property <string> launcher-progress: "0 / 9";
    in-out property <string> launcher-save-state: "";
    in-out property <string> launcher-next-task: "";
    in-out property <string> launcher-compatibility: "Minecraft Java Edition 26.1.2";

    in-out property <bool> detailed-active: false;
    in-out property <bool> can-enter-detailed: false;
    // 0 blocked, 1 select building, 2 evidence/template, 3 facade rules, 4 preview
    in-out property <int> detailed-task: 0;
    in-out property <int> active-step: 0;
    in-out property <bool> can-review-foundation: false;
    in-out property <bool> can-generate-foundation: false;
    in-out property <[string]> step-labels: ["校区", "边界", "朝向", "建筑", "道路", "水域", "植被", "体育", "导出"];
    in-out property <[CandidateRow]> candidates: [];
    in-out property <[string]> candidate-filters: [];
    in-out property <int> selected-candidate-filter: 0;
    in-out property <int> candidate-page: 0;
    in-out property <int> candidate-pages: 1;
    in-out property <[string]> building-slots: ["暂无已审核建筑"];
    in-out property <int> selected-slot: 0;
    in-out property <[string]> arnis-styles: [];
    in-out property <int> selected-style: 8;
    in-out property <string> function-classification-summary: "尚未识别用途";
    in-out property <[string]> template-proposals: [];
    in-out property <int> selected-template-proposal: 0;
    in-out property <string> facade-rule-summary: "尚未建立立面规则草案";
    in-out property <string> local-evidence-summary: "尚未添加本地照片";
    in-out property <[string]> foundation-styles: [];
    in-out property <int> selected-foundation-style: 0;
    in-out property <string> foundation-style-name: "Arnis Classic";
    in-out property <float> window-density: 50;
    in-out property <float> wall-depth: 50;
    in-out property <string> primary-label: "确认校区并继续";
    in-out property <bool> settings-visible: false;
    in-out property <bool> about-visible: false;
    in-out property <bool> utilities-visible: false;
    in-out property <string> gaode-key: "";
    in-out property <string> gaode-security: "";
    in-out property <float> orientation-degrees: 0;
    in-out property <float> blocks-per-meter: 1;
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <string> measured-height: "";
    in-out property <string> measured-floors: "";
    in-out property <string> measured-roof: "";
    in-out property <string> palette-summary: "尚未生成模型";
    in-out property <string> refinement-summary: "尚无生成版本";
    in-out property <bool> can-confirm-refinement: false;
    in-out property <string> selected-block-summary: "尚未在预览中选择方块";
    in-out property <string> selected-block-target: "";
    in-out property <bool> evidence-visible: false;
    in-out property <[string]> semantic-feature-kinds: [];
    in-out property <[string]> semantic-feature-sides: [];
    in-out property <[string]> semantic-height-bands: [];
    in-out property <[string]> semantic-strengths: [];
    in-out property <int> selected-semantic-kind: 0;
    in-out property <int> selected-semantic-side: 0;
    in-out property <int> selected-semantic-height: 0;
    in-out property <int> selected-semantic-strength: 1;
    in-out property <string> semantic-feature-label: "";
    in-out property <string> semantic-feature-reason: "";
    in-out property <string> semantic-feature-summary: "尚未标注识别特征";
    in-out property <string> observed-evidence-summary: "尚未选择建筑槽位";
    in-out property <string> generated-interpretation-summary: "尚未生成解释结果";
    in-out property <[string]> external-models: [];
    in-out property <int> selected-external-model: 0;
    in-out property <string> external-model-summary: "";
    in-out property <[string]> external-model-decisions: [];
    in-out property <int> selected-external-decision: 0;
    in-out property <string> external-model-reason: "";
    in-out property <[string]> source-conflicts: [];
    in-out property <int> selected-source-conflict: 0;
    in-out property <string> source-conflict-summary: "";
    in-out property <[string]> source-conflict-decisions: [];
    in-out property <int> selected-source-conflict-decision: 0;
    in-out property <string> source-conflict-reason: "";
    in-out property <bool> candidate-details-visible: false;
    in-out property <string> selected-candidate-name: "";
    in-out property <string> selected-candidate-details: "";
    in-out property <bool> selected-candidate-is-building: false;
    in-out property <string> candidate-name-draft: "";
    in-out property <string> candidate-suppression-reason: "";
    in-out property <[string]> building-suppressions: [];
    in-out property <int> selected-building-suppression: 0;
    in-out property <string> replace-source: "";
    in-out property <string> replace-target: "";
    in-out property <bool> english: false;

    callback create-project(string, string);
    callback open-project();
    callback save-project();
    callback save-project-as();
    callback switch-mode(bool);
    callback select-step(int);
    callback confirm-step();
    callback review-candidate(string, bool);
    callback reset-candidate-review(string);
    callback review-visible-candidates(bool);
    callback choose-candidate-filter(int);
    callback change-candidate-page(int);
    callback open-map();
    callback open-detailed-map();
    callback open-preview();
    callback choose-style(int, float, float);
    callback choose-template-proposal(int);
    callback import-local-evidence();
    callback choose-foundation-style(int);
    callback import-foundation-style();
    callback preview-foundation();
    callback choose-slot(int);
    callback generate-building();
    callback confirm-refinement();
    callback export-building();
    callback export-project();
    callback save-map-settings(string, string);
    callback set-foundation-metrics(float, float);
    callback undo();
    callback redo();
    callback update-building-measurements(string, string, string);
    callback replace-generated-block(string, string);
    callback replace-selected-block(string);
    callback apply-semantic-feature(int, int, int, int, string, string);
    callback choose-external-model(int);
    callback review-external-model(int, int, string);
    callback choose-source-conflict(int);
    callback review-source-conflict(int, int, string);
    callback open-candidate-details(string);
    callback rename-selected-building(string);
    callback suppress-selected-building(string);
    callback restore-building-suppression(int);
    callback set-locale(bool);
    callback dismiss-error();
    callback open-diagnostics();

    callback confirm-launcher-campus();
    callback search-launcher-campus();
    callback import-portable-project();
    callback create-library-project(string);
    callback open-library-project(string);
    callback export-library-project(string);
    callback show-project-library();
    callback show-campus-selection();
    shortcut-scope := FocusScope {
      VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 66px;
            background: #eee6d6;
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 18px;
                spacing: 10px;
                Text { text: root.english ? "MC Campus Reconstruction" : "MC 校园复刻"; font-size: 22px; font-weight: 700; color: #17251f; vertical-alignment: center; }
                Rectangle { width: 1px; height: 30px; background: #b7ad9a; }
                Text { text: root.project-name; color: #4c5b53; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text { text: root.campus-launcher-visible ? root.launcher-save-state : root.save-status; color: root.error-visible ? #a54836 : #4c665b; vertical-alignment: center; }
                if root.tool-status != "" : Text {
                    text: root.tool-status;
                    color: #617068;
                    vertical-alignment: center;
                }
                Button { text: root.english ? "中文" : "EN"; clicked => { root.set-locale(!root.english); } }
                Button { text: root.english ? "Undo" : "撤销"; enabled: root.can-undo; clicked => { root.undo(); } }
                Button { text: root.english ? "Redo" : "重做"; enabled: root.can-redo; clicked => { root.redo(); } }
                if !root.campus-launcher-visible : Button { text: root.english ? "More" : "更多"; clicked => { root.utilities-visible = true; } }
                Button { text: root.english ? "Save" : "保存"; enabled: !root.campus-launcher-visible || root.launcher-active-project-id != ""; clicked => { root.save-project(); } }
            }
        }
        Rectangle { height: 2px; background: #23362e; }
        if root.error-visible : Rectangle {
            height: 88px;
            background: #f6ddd5;
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 18px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 12px;
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.error-summary;
                        color: #7c2f25;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.error-details;
                        color: #6d4840;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
                Button {
                    text: root.english ? "Open logs" : "打开日志";
                    clicked => { root.open-diagnostics(); }
                }
                Button {
                    text: root.english ? "Dismiss" : "关闭";
                    clicked => { root.dismiss-error(); }
                }
            }
        }

        VerticalLayout {
            spacing: 0px;
        if root.campus-launcher-visible : Rectangle {
            height: 64px;
            background: #e7dfcf;
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                spacing: 8px;
                Button {
                    text: "1  CAMPUS TARGET";
                    enabled: root.route-stage != 0;
                    clicked => { root.show-campus-selection(); }
                }
                Button {
                    text: "2  PROJECT";
                    enabled: root.launcher-step == 2;
                    clicked => { root.show-project-library(); }
                }
                Button { text: "3  FOUNDATION"; enabled: false; }
                Button { text: "4  DETAILED"; enabled: false; }
                Button { text: "5  AXIOM"; enabled: false; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text {
                    text: root.launcher-campus-name;
                    color: #4c5b53;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: 0px;
        if root.campus-launcher-visible && root.launcher-step < 2 : HorizontalLayout {
            spacing: 0px;
            Rectangle {
                background: #faf8f1;
                VerticalLayout {
                    padding: 28px;
                    spacing: 14px;
                    SectionLabel { text: "CURRENT TASK"; }
                    if root.launcher-step == 0 : VerticalLayout {
                        spacing: 14px;
                        Text {
                            text: root.english ? "Confirm the campus to reconstruct" : "确认要复刻的校区";
                            font-size: 28px;
                            font-weight: 700;
                            color: #17251f;
                        }
                        Text {
                            text: root.english
                                ? "Confirm a Campus Target before any project list is shown."
                                : "先确认校区目标，随后才显示该校区的项目。";
                            color: #5b665f;
                        }
                        Rectangle {
                            height: 150px;
                            background: #f0eadc;
                            border-color: #b7ad9a;
                            border-width: 1px;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                SectionLabel { text: root.english ? "OFFERED CAMPUS TARGET" : "待确认校区目标"; }
                                Text { text: root.launcher-campus-name; font-size: 21px; font-weight: 700; color: #17251f; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Button {
                                        text: root.english ? "Confirm this campus" : "确认该校区";
                                        enabled: root.launcher-campus-name != "";
                                        clicked => { root.confirm-launcher-campus(); }
                                    }
                                    Button {
                                        text: root.english ? "Search another campus" : "搜索其他校区";
                                        clicked => { root.search-launcher-campus(); }
                                    }
                                    Button {
                                        text: root.english ? "Import Portable Project" : "导入便携项目";
                                        clicked => { root.import-portable-project(); }
                                    }
                                }
                            }
                        }
                    }
                    if root.launcher-step == 1 : VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: root.english ? "Campus Project Library" : "校区项目库";
                            font-size: 28px;
                            font-weight: 700;
                            color: #17251f;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                text <=> root.launcher-new-project-name;
                                placeholder-text: root.english ? "New project name" : "新项目名称";
                            }
                            Button {
                                text: root.english ? "Create project" : "新建项目";
                                clicked => { root.create-library-project(root.launcher-new-project-name); }
                            }
                            Button {
                                text: root.english ? "Import Portable Project" : "导入便携项目";
                                clicked => { root.import-portable-project(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            SectionLabel { text: root.english ? "PROJECT NAME" : "项目名称"; width: 180px; }
                            SectionLabel { text: "LATEST SAVE"; width: 100px; }
                            SectionLabel { text: "SAVE / RECOVERY"; width: 120px; }
                            SectionLabel { text: "PROGRESS"; width: 80px; }
                            SectionLabel { text: "NEXT TASK"; }
                        }
                        for project in root.launcher-projects : Rectangle {
                            height: 76px;
                            background: #f4f0e5;
                            border-color: #c7bca8;
                            border-width: 1px;
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 12px;
                                Text { text: project.project-name; width: 180px; font-weight: 700; color: #17251f; }
                                Text { text: project.latest-save; width: 100px; color: #506058; }
                                Text { text: project.save-state; width: 120px; color: #506058; }
                                Text { text: project.progress; width: 80px; color: #506058; }
                                Text { text: project.next-task; color: #33463d; }
                                Button { text: project.action-label; clicked => { root.open-library-project(project.project-id); } }
                                Button { text: root.english ? "Portable export" : "便携导出"; clicked => { root.export-library-project(project.project-id); } }
                            }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: #d0c7b6; }
            Rectangle {
                width: 280px;
                background: #f2eee4;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    SectionLabel { text: "PROJECT CONTEXT"; }
                    Text { text: root.launcher-campus-name; font-size: 18px; font-weight: 700; color: #17251f; wrap: word-wrap; }
                    Rule {}
                    SectionLabel { text: "PROGRESS"; }
                    Text { text: root.launcher-progress; color: #33463d; }
                    SectionLabel { text: "SAVE / RECOVERY"; }
                    Text { text: root.launcher-save-state; color: #4c665b; wrap: word-wrap; }
                    SectionLabel { text: "NEXT TASK"; }
                    Text { text: root.launcher-next-task; color: #33463d; wrap: word-wrap; }
                    SectionLabel { text: "MINECRAFT COMPATIBILITY"; }
                    Text { text: root.launcher-compatibility; color: #506058; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }

        if root.campus-launcher-visible && root.launcher-step == 2 : HorizontalLayout {
            spacing: 0px;
            Rectangle {
                background: #faf8f1;
                VerticalLayout {
                    padding: 32px;
                    spacing: 16px;
                    SectionLabel { text: "CURRENT TASK"; }
                    Text {
                        text: root.launcher-next-task == "Completion and export"
                            ? "Completion and Portable Export"
                            : "Resume Point";
                        font-size: 28px;
                        font-weight: 700;
                        color: #17251f;
                    }
                    Text {
                        text: root.project-name;
                        font-size: 20px;
                        font-weight: 700;
                        color: #33463d;
                    }
                    Rectangle {
                        height: 150px;
                        background: #f0eadc;
                        border-color: #b7ad9a;
                        border-width: 1px;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            SectionLabel { text: "NEXT ACTION"; }
                            Text {
                                text: root.launcher-next-task;
                                font-size: 22px;
                                font-weight: 700;
                                color: #17251f;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "This workspace is backed only by the active schema-2 project session.";
                                color: #5b665f;
                                wrap: word-wrap;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Button {
                            text: "Back to project library";
                            clicked => { root.show-project-library(); }
                        }
                        Button {
                            text: "Portable export";
                            enabled: root.launcher-active-project-id != "";
                            clicked => { root.export-library-project(root.launcher-active-project-id); }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
            Rectangle { width: 1px; background: #d0c7b6; }
            Rectangle {
                width: 280px;
                background: #f2eee4;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    SectionLabel { text: "PROJECT CONTEXT"; }
                    Text { text: root.launcher-campus-name; font-size: 18px; font-weight: 700; color: #17251f; wrap: word-wrap; }
                    Text { text: root.project-name; color: #33463d; wrap: word-wrap; }
                    Rule {}
                    SectionLabel { text: "PROGRESS"; }
                    Text { text: root.launcher-progress; color: #33463d; }
                    SectionLabel { text: "SAVE / RECOVERY"; }
                    Text { text: root.launcher-save-state; color: #4c665b; wrap: word-wrap; }
                    SectionLabel { text: "NEXT TASK"; }
                    Text { text: root.launcher-next-task; color: #33463d; wrap: word-wrap; }
                    SectionLabel { text: "MINECRAFT COMPATIBILITY"; }
                    Text { text: root.launcher-compatibility; color: #506058; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }
            if !root.campus-launcher-visible : Rectangle {
                width: 260px;
                background: #ece4d3;
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    SectionLabel { text: root.english ? "PROJECT TASKS" : "项目任务"; }
                    Text { text: root.project-name; color: #17251f; font-size: 16px; font-weight: 700; wrap: word-wrap; }
                    Text { text: root.campus-name; color: #506058; font-size: 12px; wrap: word-wrap; }
                    Rule {}
                    Button {
                        text: root.has-campus-target
                            ? (root.english ? "1. Campus selected" : "1. 校区已选择")
                            : (root.english ? "1. Select campus" : "1. 选择校区");
                        enabled: root.detailed-active || root.active-step != 0;
                        clicked => { root.switch-mode(false); root.select-step(0); }
                    }
                    Button {
                        text: root.active-step > 1
                            ? (root.english ? "2. Boundary confirmed" : "2. 范围已确认")
                            : (root.english ? "2. Confirm boundary" : "2. 确认范围");
                        enabled: false;
                    }
                    Button {
                        text: root.english ? "3. Review Foundation" : "3. 审核地基";
                        enabled: root.can-review-foundation && (root.detailed-active || root.active-step < 3 || root.active-step > 7);
                        clicked => { root.switch-mode(false); root.select-step(3); }
                    }
                    Button {
                        text: root.english ? "4. Generate Foundation" : "4. 生成地基";
                        enabled: root.can-generate-foundation && (root.detailed-active || root.active-step != 8);
                        clicked => { root.switch-mode(false); root.select-step(8); }
                    }
                    Button {
                        text: root.can-enter-detailed
                            ? (root.english ? "5. Refine a building" : "5. 单栋精修")
                            : (root.english ? "5. Refine a building · blocked" : "5. 单栋精修 · 未解锁");
                        enabled: !root.detailed-active;
                        clicked => { root.switch-mode(true); }
                    }
                    if !root.can-enter-detailed : Text {
                        text: root.english ? "Confirm at least one building in task 3." : "在任务 3 中确认至少一栋建筑后解锁。";
                        color: #6d665b;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Rule {}
                    SectionLabel { text: root.english ? "PROGRESS" : "项目进度"; }
                    Text { text: root.project-summary; color: #506058; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
            if !root.campus-launcher-visible : Rectangle { width: 1px; background: #948a78; }

            if !root.campus-launcher-visible : Rectangle {
                background: #faf8f1;
                VerticalLayout {
                    padding: 28px;
                    spacing: 14px;
                    SectionLabel { text: root.detailed-active ? (root.english ? "DETAILED BUILDING" : "精细建筑") : (root.english ? "FOUNDATION & CAMPUS" : "地基与校区"); }
                    Text { text: root.page-title; font-size: 28px; font-weight: 700; color: #17251f; }
                    Text { text: root.page-help; font-size: 15px; color: #5b665f; wrap: word-wrap; }
                    Rule {}

                    workflow-scroll := ScrollView {
                        preferred-height: 0px;
                        workflow-content := VerticalLayout {
                        alignment: start;
                        padding-right: 12px;
                        spacing: 14px;
                    if !root.detailed-active && root.active-step == 0 : Rectangle {
                        height: 270px;
                        background: #f4f0e5;
                        border-color: #23362e;
                        border-width: 1px;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            SectionLabel { text: root.english ? "LOCAL PROJECT" : "本地项目"; }
                            LineEdit { text <=> root.project-name; placeholder-text: root.english ? "Project name" : "项目名称"; }
                            LineEdit { text <=> root.campus-name; placeholder-text: root.english ? "School and campus" : "学校与校区"; }
                            Button {
                                text: root.has-campus-target
                                    ? (root.english ? "Change campus in Gaode" : "在高德中更换校区")
                                    : (root.english ? "Create project and select campus" : "创建项目并选择高德校区");
                                clicked => {
                                    if !root.has-campus-target {
                                        root.create-project(root.project-name, root.campus-name);
                                    }
                                    root.open-map();
                                }
                            }
                        }
                    }

                    if !root.detailed-active && root.active-step == 1 : Rectangle {
                        height: 210px;
                        background: #f4f0e5;
                        border-color: #23362e;
                        border-width: 1px;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            SectionLabel { text: root.english ? "CAMPUS BOUNDARY" : "校区边界"; }
                            Text {
                                text: root.english
                                    ? "Edit one campus boundary on the Gaode base map. Confirming it opens orientation setup."
                                    : "在高德底图上编辑唯一的校区边界；确认后直接进入朝向设置。";
                                color: #506058;
                                wrap: word-wrap;
                            }
                            Button { text: root.english ? "Edit and confirm boundary" : "编辑并确认校区边界"; clicked => { root.open-map(); } }
                        }
                    }

                    if !root.detailed-active && root.active-step == 2 : Rectangle {
                        height: 220px;
                        background: #f4f0e5;
                        border-color: #c7bca8;
                        border-width: 1px;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;
                            SectionLabel { text: root.english ? "COORDINATE TRANSFORM" : "坐标转换"; }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: root.english ? "Campus axis" : "校园主轴"; width: 90px; vertical-alignment: center; }
                                Slider { value <=> root.orientation-degrees; minimum: -180; maximum: 180; }
                                Text { text: round(root.orientation-degrees) + "°"; width: 60px; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: root.english ? "Blocks / m" : "方块 / 米"; width: 90px; vertical-alignment: center; }
                                Slider { value <=> root.blocks-per-meter; minimum: 0.25; maximum: 4; }
                                Text { text: round(root.blocks-per-meter * 100) / 100; width: 60px; vertical-alignment: center; }
                            }
                            Button {
                                text: root.english ? "Apply orientation and scale" : "应用朝向与比例";
                                clicked => { root.set-foundation-metrics(root.orientation-degrees, root.blocks-per-meter); }
                            }
                        }
                    }

                    if !root.detailed-active && root.active-step > 2 && root.active-step < 8 : VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            Text { text: root.project-summary; color: #506058; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button { text: root.english ? "Edit on map" : "在地图中编辑"; clicked => { root.open-map(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            candidate-filter-box := ComboBox {
                                model: root.candidate-filters;
                                current-index <=> root.selected-candidate-filter;
                                selected(value) => {
                                    root.choose-candidate-filter(candidate-filter-box.current-index);
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button { text: root.english ? "Reject visible" : "批量拒绝"; clicked => { root.review-visible-candidates(false); } }
                            Button { text: root.english ? "Accept visible" : "批量接受"; clicked => { root.review-visible-candidates(true); } }
                        }
                        for candidate in root.candidates: CandidateItem {
                            candidate: candidate;
                            english: root.english;
                            decide(id, accepted) => { root.review-candidate(id, accepted); }
                            reset(id) => { root.reset-candidate-review(id); }
                            inspect(id) => { root.open-candidate-details(id); }
                        }
                        if root.candidates.length == 0 : Rectangle {
                            height: 120px;
                            background: #f4f0e5;
                            border-color: #c7bca8;
                            border-width: 1px;
                            Text {
                                text: root.english ? "No pending objects in this step. Review pinned source coverage and acknowledge any Known Feature Gaps." : "当前步骤没有待审核对象。请检查已固定的来源覆盖，并确认所有已知地物缺口。";
                                color: #68756e; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: root.english ? "Previous" : "上一页";
                                enabled: root.candidate-page > 0;
                                clicked => { root.change-candidate-page(-1); }
                            }
                            Text {
                                text: (root.candidate-page + 1) + " / " + root.candidate-pages;
                                color: #506058;
                                vertical-alignment: center;
                            }
                            Button {
                                text: root.english ? "Next" : "下一页";
                                enabled: root.candidate-page + 1 < root.candidate-pages;
                                clicked => { root.change-candidate-page(1); }
                            }
                        }
                    }

                    if !root.detailed-active && root.active-step == 8 : VerticalLayout {
                        spacing: 14px;
                        Text { text: root.project-summary; color: #33463d; }
                        SectionLabel { text: root.english ? "FOUNDATION STYLE PRESET" : "Foundation 样式预设"; }
                        foundation-style-box := ComboBox {
                            model: root.foundation-styles;
                            current-index <=> root.selected-foundation-style;
                            selected(value) => {
                                root.choose-foundation-style(foundation-style-box.current-index);
                            }
                        }
                        Text { text: (root.english ? "Current style pack: " : "当前样式包：") + root.foundation-style-name; color: #506058; }
                        Button {
                            text: root.english ? "Import advanced JSON style pack" : "导入进阶 JSON 样式包";
                            clicked => { root.import-foundation-style(); }
                        }
                        Button {
                            text: root.english ? "Generate and open native Foundation preview" : "生成并打开 Foundation 原生预览";
                            clicked => { root.preview-foundation(); }
                        }
                        Button { text: root.english ? "Export Foundation project and .schem" : "导出 Foundation 工程与 .schem"; clicked => { root.export-project(); } }
                    }

                    if root.detailed-active && root.detailed-task == 1 : VerticalLayout {
                        spacing: 12px;
                        SectionLabel { text: root.english ? "CHOOSE ONE REVIEWED BUILDING" : "选择一栋已审阅建筑"; }
                        task-slot-box := ComboBox {
                            model: root.building-slots;
                            current-index <=> root.selected-slot;
                        }
                        Button {
                            text: root.english ? "Use this building" : "精修这栋建筑";
                            clicked => { root.choose-slot(task-slot-box.current-index); }
                        }
                    }

                    if root.detailed-active && root.detailed-task == 2 : VerticalLayout {
                        spacing: 12px;
                        SectionLabel { text: root.english ? "MEASURED GEOMETRY" : "实测几何"; }
                        HorizontalLayout {
                            spacing: 10px;
                            LineEdit { text <=> root.measured-height; placeholder-text: root.english ? "Height (m)" : "高度（米）"; }
                            LineEdit { text <=> root.measured-floors; placeholder-text: root.english ? "Floors" : "楼层"; }
                            LineEdit { text <=> root.measured-roof; placeholder-text: root.english ? "Roof shape" : "屋顶形状"; }
                            Button {
                                text: root.english ? "Save" : "保存";
                                clicked => { root.update-building-measurements(root.measured-height, root.measured-floors, root.measured-roof); }
                            }
                        }
                        SectionLabel { text: root.english ? "AUTOMATIC MATCH" : "自动匹配"; }
                        Text { text: root.function-classification-summary; color: #33463d; wrap: word-wrap; }
                        Text { text: root.local-evidence-summary; color: #506058; wrap: word-wrap; }
                        Button {
                            text: root.english ? "Add building photos" : "添加建筑照片";
                            clicked => { root.import-local-evidence(); }
                        }
                        task-template-box := ComboBox {
                            model: root.template-proposals;
                            current-index <=> root.selected-template-proposal;
                        }
                        Button {
                            text: root.english ? "Use this template" : "采用此模板";
                            clicked => { root.choose-template-proposal(task-template-box.current-index); }
                        }
                    }

                    if root.detailed-active && root.detailed-task == 3 : VerticalLayout {
                        spacing: 12px;
                        SectionLabel { text: root.english ? "EDITABLE FACADE RULES" : "可编辑立面规则"; }
                        Text { text: root.facade-rule-summary; color: #33463d; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: root.english ? "Window density" : "窗户密度"; width: 110px; vertical-alignment: center; }
                            Slider { value <=> root.window-density; minimum: 0; maximum: 100; }
                            Text { text: round(root.window-density) + "%"; width: 48px; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: root.english ? "Wall depth" : "墙面层次"; width: 110px; vertical-alignment: center; }
                            Slider { value <=> root.wall-depth; minimum: 0; maximum: 100; }
                            Text { text: round(root.wall-depth) + "%"; width: 48px; vertical-alignment: center; }
                        }
                        Button {
                            text: root.english ? "Generate and open preview" : "生成并打开预览";
                            clicked => { root.generate-building(); }
                        }
                    }

                    if root.detailed-active && root.detailed-task == 4 : VerticalLayout {
                        spacing: 12px;
                        SectionLabel { text: root.english ? "REVIEW GENERATED BUILDING" : "审阅生成建筑"; }
                        Text { text: root.refinement-summary; color: #33463d; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 10px;
                            Button { text: root.english ? "Open preview" : "打开预览"; clicked => { root.open-preview(); } }
                            Button {
                                text: root.english ? "Confirm this version" : "确认此版本";
                                enabled: root.can-confirm-refinement;
                                clicked => { root.confirm-refinement(); }
                            }
                        }
                        Text { text: (root.english ? "Selected block: " : "选中方块：") + root.selected-block-summary; color: #506058; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 10px;
                            LineEdit { text <=> root.selected-block-target; placeholder-text: root.english ? "Replacement block ID" : "替换方块 ID"; }
                            Button { text: root.english ? "Replace selected" : "替换选中方块"; clicked => { root.replace-selected-block(root.selected-block-target); } }
                        }
                        Button {
                            text: root.english ? "Evidence and detected features" : "证据与识别特征";
                            clicked => { root.evidence-visible = true; }
                        }
                    }

                      }
                    }
                    if root.detailed-active && root.detailed-task == 4 : detailed-export := Button {
                        text: root.english ? "Export detailed building .schem" : "导出当前精细建筑 .schem";
                        clicked => { root.export-building(); }
                    }
                }
            }
            if !root.campus-launcher-visible : Rectangle { width: 1px; background: #d0c7b6; }
            if !root.campus-launcher-visible : Rectangle {
                width: 270px;
                background: #f2eee4;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    SectionLabel { text: root.english ? "CURRENT TASK" : "当前任务"; }
                    Text { text: root.page-title; color: #17251f; font-size: 19px; font-weight: 700; wrap: word-wrap; }
                    Text { text: root.page-help; color: #5b665f; font-size: 12px; wrap: word-wrap; }
                    Rule {}
                    SectionLabel { text: root.english ? "PROJECT STATUS" : "项目状态"; }
                    Text { text: root.project-summary; color: #33463d; wrap: word-wrap; }
                    Text {
                        text: root.save-status;
                        color: root.error-visible ? #a54836 : #4c665b;
                        font-size: 12px;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    if !root.detailed-active && root.active-step > 1 : Button {
                        text: root.primary-label;
                        clicked => { root.confirm-step(); }
                    }
                    if root.detailed-active && !root.can-confirm-refinement : Text {
                        text: root.english ? "Generate a preview before confirming or exporting." : "先生成预览，再确认或导出精修版本。";
                        color: #6d665b;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
        }
        }
      }
      KeyBinding { keys: @keys(Control + S); activated => { root.save-project(); } }
      KeyBinding { keys: @keys(Control + Z); activated => { root.undo(); } }
      KeyBinding { keys: @keys(Control + Y); activated => { root.redo(); } }
      KeyBinding { keys: @keys(Control + Shift + Z); activated => { root.redo(); } }
    }

    if root.settings-visible : Rectangle {
        x: 360px;
        y: 170px;
        width: 560px;
        height: 330px;
        background: #f4f0e5;
        border-color: #23362e;
        border-width: 2px;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000055;
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            SectionLabel { text: root.english ? "GAODE MAP SERVICE" : "高德地图服务"; }
            Text { text: root.english ? "Credentials are stored only in Windows Credential Manager, never in projects or the repository." : "密钥只保存在 Windows 凭据管理器，不写入项目或仓库。"; color: #506058; wrap: word-wrap; }
            LineEdit { text <=> root.gaode-key; placeholder-text: "Web JS API Key"; }
            LineEdit { text <=> root.gaode-security; placeholder-text: root.english ? "securityJsCode paired with this Web JS API Key" : "与此 Web JS API Key 配对的 securityJsCode"; }
            Text {
                text: root.english ? "The key and securityJsCode must come from the same Web (JS API) entry in the Gaode console." : "Key 与 securityJsCode 必须来自高德控制台中的同一条 Web（JS API）配置。";
                color: #506058;
                font-size: 12px;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button { text: root.english ? "Cancel" : "取消"; clicked => { root.settings-visible = false; } }
                Button {
                    text: root.english ? "Save securely" : "安全保存";
                    clicked => {
                        root.save-map-settings(root.gaode-key, root.gaode-security);
                        root.settings-visible = false;
                    }
                }
            }
        }
    }

    if root.utilities-visible : Rectangle {
        x: 700px;
        y: 78px;
        width: 300px;
        height: 290px;
        background: #f4f0e5;
        border-color: #23362e;
        border-width: 2px;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000055;
        VerticalLayout {
            padding: 20px;
            spacing: 10px;
            SectionLabel { text: root.english ? "PROJECT & TOOLS" : "项目与工具"; }
            Button {
                text: root.english ? "Open project" : "打开项目";
                clicked => { root.open-project(); root.utilities-visible = false; }
            }
            Button {
                text: root.english ? "Save as" : "另存为";
                clicked => { root.save-project-as(); root.utilities-visible = false; }
            }
            Button {
                text: root.english ? "Map settings" : "地图设置";
                clicked => { root.settings-visible = true; root.utilities-visible = false; }
            }
            Button {
                text: root.english ? "Diagnostics" : "诊断日志";
                clicked => { root.open-diagnostics(); root.utilities-visible = false; }
            }
            Button {
                text: root.english ? "About" : "关于";
                clicked => { root.about-visible = true; root.utilities-visible = false; }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
            Button { text: root.english ? "Close" : "关闭"; clicked => { root.utilities-visible = false; } }
        }
    }

    if root.about-visible : Rectangle {
        x: 420px;
        y: 190px;
        width: 440px;
        height: 300px;
        background: #f4f0e5;
        border-color: #23362e;
        border-width: 2px;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000055;
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            SectionLabel { text: root.english ? "ABOUT CAMPUS RECONSTRUCTION TOOL" : "关于 Campus Reconstruction Tool"; }
            Text { text: root.english ? "V1 · Native Slint / Rust campus reconstruction workbench" : "V1 · 原生 Slint / Rust 校园复刻工作台"; color: #17251f; }
            AboutSlint {}
            Rectangle { vertical-stretch: 1; background: transparent; }
            Button { text: root.english ? "Close" : "关闭"; clicked => { root.about-visible = false; } }
        }
    }

    if root.evidence-visible : Rectangle {
        x: 220px;
        y: 85px;
        width: 840px;
        height: 650px;
        background: #f4f0e5;
        border-color: #23362e;
        border-width: 2px;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000055;
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            HorizontalLayout {
                SectionLabel { text: root.english ? "DETAILED EVIDENCE & SEMANTICS" : "Detailed 证据与识别特征"; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button { text: root.english ? "Close" : "关闭"; clicked => { root.evidence-visible = false; } }
            }
            Rule {}
            ScrollView {
                VerticalLayout {
                    padding-right: 12px;
                    spacing: 12px;
                    SectionLabel { text: root.english ? "OBSERVED BUILDING EVIDENCE" : "观测建筑证据"; }
                    Text {
                        text: root.observed-evidence-summary;
                        color: #33463d;
                        wrap: word-wrap;
                    }
                    Button {
                        text: root.english ? "Compare Gaode 3D with reviewed footprint" : "打开高德 3D 与已审核轮廓对照";
                        clicked => { root.open-detailed-map(); }
                    }
                    SectionLabel { text: root.english ? "GENERATED INTERPRETATION" : "生成建筑解释"; }
                    Text {
                        text: root.generated-interpretation-summary;
                        color: #33463d;
                        wrap: word-wrap;
                    }
                    Rule {}
                    SectionLabel { text: root.english ? "EXTERNAL 3D MODEL LICENSE REVIEW" : "外部 3D 模型许可审核"; }
                    external-model-box := ComboBox {
                        model: root.external-models;
                        current-index <=> root.selected-external-model;
                        selected(value) => {
                            root.choose-external-model(external-model-box.current-index);
                        }
                    }
                    Text {
                        text: root.external-model-summary;
                        color: #506058;
                        wrap: word-wrap;
                    }
                    external-decision-box := ComboBox {
                        model: root.external-model-decisions;
                        current-index <=> root.selected-external-decision;
                    }
                    LineEdit {
                        text <=> root.external-model-reason;
                        placeholder-text: root.english ? "External model review reason" : "外部模型审核理由";
                    }
                    Button {
                        text: root.english ? "Save external model review" : "保存外部模型审核";
                        clicked => {
                            root.review-external-model(
                                root.selected-external-model,
                                root.selected-external-decision,
                                root.external-model-reason
                            );
                        }
                    }
                    SectionLabel { text: root.english ? "SOURCE CONFLICT REVIEW" : "来源冲突审核"; }
                    source-conflict-box := ComboBox {
                        model: root.source-conflicts;
                        current-index <=> root.selected-source-conflict;
                        selected(value) => {
                            root.choose-source-conflict(source-conflict-box.current-index);
                        }
                    }
                    Text {
                        text: root.source-conflict-summary;
                        color: #506058;
                        wrap: word-wrap;
                    }
                    conflict-decision-box := ComboBox {
                        model: root.source-conflict-decisions;
                        current-index <=> root.selected-source-conflict-decision;
                    }
                    LineEdit {
                        text <=> root.source-conflict-reason;
                        placeholder-text: root.english ? "Source conflict decision reason" : "来源冲突决策理由";
                    }
                    Button {
                        text: root.english ? "Save source conflict decision" : "保存来源冲突决策";
                        clicked => {
                            root.review-source-conflict(
                                root.selected-source-conflict,
                                root.selected-source-conflict-decision,
                                root.source-conflict-reason
                            );
                        }
                    }
                    Rule {}
                    SectionLabel { text: root.english ? "SEMANTIC FEATURE PRESERVATION" : "语义特征保留"; }
                    Text {
                        text: root.english ? "Mark entrances, window bands, ridges, eaves, or frames. Rules improve local identity without changing the envelope." : "标注入口、窗带、屋脊、檐口或框架；规则只增强局部可识别性，不改变建筑包络。";
                        color: #506058;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        semantic-kind-box := ComboBox {
                            model: root.semantic-feature-kinds;
                            current-index <=> root.selected-semantic-kind;
                        }
                        semantic-side-box := ComboBox {
                            model: root.semantic-feature-sides;
                            current-index <=> root.selected-semantic-side;
                        }
                        semantic-height-box := ComboBox {
                            model: root.semantic-height-bands;
                            current-index <=> root.selected-semantic-height;
                        }
                        semantic-strength-box := ComboBox {
                            model: root.semantic-strengths;
                            current-index <=> root.selected-semantic-strength;
                        }
                    }
                    LineEdit {
                        text <=> root.semantic-feature-label;
                        placeholder-text: root.english ? "Feature name, e.g. Library south entrance" : "特征名称，例如：图书馆南门";
                    }
                    LineEdit {
                        text <=> root.semantic-feature-reason;
                        placeholder-text: root.english ? "Evidence reason, e.g. visible in Gaode 3D and photos" : "证据理由，例如：高德 3D 与现场照片均可见";
                    }
                    Text {
                        text: root.semantic-feature-summary;
                        color: #506058;
                        wrap: word-wrap;
                    }
                    Button {
                        text: root.english ? "Apply to current refinement" : "应用到当前 refinement";
                        clicked => {
                            root.apply-semantic-feature(
                                root.selected-semantic-kind,
                                root.selected-semantic-side,
                                root.selected-semantic-height,
                                root.selected-semantic-strength,
                                root.semantic-feature-label,
                                root.semantic-feature-reason
                            );
                        }
                    }
                }
            }
        }
    }

    if root.candidate-details-visible : Rectangle {
        x: 360px;
        y: 145px;
        width: 600px;
        height: 470px;
        background: #f4f0e5;
        border-color: #23362e;
        border-width: 2px;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000055;
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            HorizontalLayout {
                SectionLabel { text: root.english ? "CANDIDATE SOURCE & BUILDING DIRECTORY" : "候选来源与建筑目录"; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button { text: root.english ? "Close" : "关闭"; clicked => { root.candidate-details-visible = false; } }
            }
            Text {
                text: root.selected-candidate-name;
                font-size: 20px;
                font-weight: 700;
                color: #17251f;
            }
            Text {
                text: root.selected-candidate-details;
                color: #506058;
                wrap: word-wrap;
            }
            if root.selected-candidate-is-building : VerticalLayout {
                spacing: 8px;
                LineEdit {
                    text <=> root.candidate-name-draft;
                    placeholder-text: root.english ? "Reviewed building name" : "审核后的建筑名称";
                }
                Button {
                    text: root.english ? "Save building name" : "保存建筑名称";
                    clicked => { root.rename-selected-building(root.candidate-name-draft); }
                }
                LineEdit {
                    text <=> root.candidate-suppression-reason;
                    placeholder-text: root.english ? "Suppression reason (wrong object, off-campus, etc.)" : "抑制理由（错误对象、校外建筑等）";
                }
                Button {
                    text: root.english ? "Persistently suppress this source" : "持久抑制此建筑来源";
                    clicked => { root.suppress-selected-building(root.candidate-suppression-reason); }
                }
            }
            Rule {}
            SectionLabel { text: root.english ? "RECOVERABLE BUILDING SUPPRESSIONS" : "可恢复的建筑抑制"; }
            suppression-box := ComboBox {
                model: root.building-suppressions;
                current-index <=> root.selected-building-suppression;
            }
            Button {
                text: root.english ? "Restore selected source (returns on next query)" : "恢复所选来源（下次查询重新出现）";
                enabled: root.building-suppressions.length > 0;
                clicked => { root.restore-building-suppression(root.selected-building-suppression); }
            }
        }
    }
}
